index 00000000..83d73727
--- /dev/null
+++ b/crates/openlogi-core/src/hid/stored_profile.rs
@@ -0,0 +1,168 @@
+//! A gaming mouse's stored profiles, for editing. Wire types: field and
+//! variant order matter, and variants are append-only.
+//!
+//! These mirror the `0x8100` codec in `openlogi-hidpp`, which this crate must
+//! not depend on; the device crate converts between the two.
+
+use serde::{Deserialize, Serialize};
+
+use super::onboard::{OnboardMode, ProfileIndex};
+use crate::color::Rgb;
+
+/// Number of DPI levels a profile stores.
+pub const STORED_DPI_LEVELS: usize = 5;
+
+/// What a button does, as stored in the profile.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum StoredBinding {
+    /// Mouse button `1..=16` (1 left, 2 right, 3 middle, 4 back, 5 forward).
+    MouseButton(u8),
+    /// A keyboard key: boot-keyboard modifier byte and HID usage.
+    Key {
+        /// Bit 0 left Ctrl, 1 left Shift, 2 left Alt, 3 left GUI; 4–7 right.
+        modifiers: u8,
+        /// HID usage (page 7).
+        usage: u8,
+    },
+    /// A consumer-control usage (media keys).
+    Consumer(u16),
+    /// A firmware function (DPI cycling, profile switching, …).
+    Special {
+        /// The function number.
+        function: u8,
+        /// Its stored profile argument.
+        profile: u8,
+    },
+    /// A macro in onboard memory.
+    StoredMacro {
+        /// The macro's sector.
+        sector: u8,
+        /// Its offset in that sector.
+        offset: u8,
+    },
+    /// Does nothing.
+    Disabled,
+    /// A binding the codec does not decode; written back unchanged.
+    Other([u8; 4]),
+}
+
+/// A lighting zone's stored effect.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum StoredLed {
+    /// Dark.
+    Off,
+    /// A fixed colour.
+    Fixed(Rgb),
+    /// Breathing in one colour.
+    Breathing {
+        /// The colour.
+        color: Rgb,
+        /// One breath, in milliseconds.
+        period_ms: u16,
+        /// `1..=100`.
+        brightness: u8,
+    },
+    /// Cycling through the colour wheel.
+    Cycle {
+        /// One cycle, in milliseconds.
+        period_ms: u16,
+        /// `1..=100`.
+        brightness: u8,
+    },
+    /// An effect the codec does not decode; written back unchanged.
+    Other([u8; 11]),
+}
+
+/// The editable settings of one stored profile.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub struct StoredProfileSettings {
+    /// Report interval in milliseconds: 1, 2, 4 or 8.
+    pub report_interval_ms: u8,
+    /// Index into `dpi` of the starting level.
+    pub default_dpi_level: u8,
+    /// Index into `dpi` of the DPI-shift level.
+    pub shift_dpi_level: Option<u8>,
+    /// DPI per level; `0` marks an unused level.
+    pub dpi: [u16; STORED_DPI_LEVELS],
+    /// The visible lighting per zone.
+    pub leds: [StoredLed; 2],
+    /// The copy shown while the mouse saves power.
+    pub power_save_leds: [StoredLed; 2],
+    /// One binding per button.
+    pub buttons: Vec<StoredBinding>,
+    /// The second (G-Shift) layer.
+    pub shift_buttons: Vec<StoredBinding>,
+}
+
+/// One stored profile slot.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StoredProfileSlot {
+    /// Slot number.
+    pub index: ProfileIndex,
+    /// Whether it is on in the profile list.
+    pub enabled: bool,
+    /// The sector as read: a save sends it back, and the agent refuses to
+    /// write if the mouse no longer holds exactly these bytes.
+    pub base: Vec<u8>,
+    /// The decoded settings, or why the profile can't be edited.
+    pub settings: Result<StoredProfileSettings, String>,
+}
+
+/// One step of a stored macro.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum StoredMacroStep {
+    /// Key press: modifiers and HID usage.
+    KeyDown(u8, u8),
+    /// Key release.
+    KeyUp(u8, u8),
+    /// Wait, in milliseconds.
+    Delay(u16),
+}
+
+/// A macro a profile points to.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StoredMacro {
+    /// Where it lives.
+    pub sector: u8,
+    /// Its offset there.
+    pub offset: u8,
+    /// Its steps, or why they can't be read.
+    pub steps: Result<Vec<StoredMacroStep>, String>,
+}
+
+/// A gaming mouse's stored profiles, read for editing.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StoredProfiles {
+    /// Who is in control now.
+    pub mode: OnboardMode,
+    /// The active profile; `None` in host mode.
+    pub active: Option<ProfileIndex>,
+    /// The DPI values the sensor accepts, when they could be read; without
+    /// them DPI levels are shown but not editable.
+    pub dpi_values: Option<Vec<u16>>,
+    /// The user profile slots; empty while the mouse runs its factory profiles.
+    pub profiles: Vec<StoredProfileSlot>,
+    /// What each button did in the factory profile.
+    pub factory_buttons: Vec<StoredBinding>,
+    /// The macros the profiles point to.
+    pub macros: Vec<StoredMacro>,
+}
+
+/// What a save did.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum StoredProfileSave {
+    /// Written and read back intact.
+    Saved,
+    /// The edit changed nothing; nothing was written.
+    Unchanged,
+}
+
+impl StoredProfiles {
+    /// The macro at `sector`, `offset`, if a profile points to it.
+    #[must_use]
+    pub fn stored_macro(&self, sector: u8, offset: u8) -> Option<&StoredMacro> {
+        self.macros
+            .iter()
+            .find(|m| m.sector == sector && m.offset == offset)
+    }
+}
