+/// The button bindings of a factory (ROM) profile sector, for naming what
+/// each button did originally. ROM sectors carry no checksum, so this reads
+/// only the binding table and never feeds a write.
+#[must_use]
+pub fn factory_bindings(sector: &[u8], button_count: u8) -> Vec<Binding> {
+    let count = usize::from(button_count).min(MAX_BUTTONS);
+    if sector.len() < BUTTONS + 4 * count {
+        return Vec::new();
+    }
+    (0..count)
+        .map(|i| {
+            let at = BUTTONS + 4 * i;
+            Binding::decode([sector[at], sector[at + 1], sector[at + 2], sector[at + 3]])
+        })
+        .collect()
+}
