+    /// The active stored profile's report rate in hertz, while a stored
+    /// profile is in control.
+    #[must_use]
+    pub fn stored_report_rate(&self) -> Option<u16> {
+        let (active, _) = self.stored_mode()?;
+        let entry = self
+            .current_record()
+            .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))?;
+        let Load::Ready(profiles) = &entry.load else {
+            return None;
+        };
+        let interval = match &entry.edit {
+            Some(edit) if edit.index == active => edit.settings.report_interval_ms,
+            _ => {
+                profiles
+                    .profiles
+                    .iter()
+                    .find(|slot| slot.index == active)?
+                    .settings
+                    .as_ref()
+                    .ok()?
+                    .report_interval_ms
+            }
+        };
+        (interval > 0).then(|| 1000 / u16::from(interval))
+    }
+
+    /// While a stored profile is in control, write `hertz` into it and
+    /// return `Some`; `None` leaves the pick to the live report-rate write.
+    pub(super) fn commit_stored_report_rate(&mut self, hertz: u16) -> Option<StateEvents> {
+        let (active, _) = self.stored_mode()?;
+        let events = self.for_current_device(StateEvent::ReportRateChanged);
+        let interval = match hertz {
+            1000 => 1,
+            500 => 2,
+            250 => 4,
+            125 => 8,
+            _ => {
+                let key = self.current_record().map(DeviceRecord::device_key)?;
+                self.stored_profiles.entry(&key).notice = Some(StoredProfileNotice::Failed(
+                    WriteError::OnboardProfileRejected {
+                        reason: format!("a stored profile can't hold {hertz} Hz"),
+                    },
+                ));
+                return Some(events);
+            }
+        };
+        let _ = self.edit_stored_profile(active, |settings| settings.report_interval_ms = interval);
+        let _ = self.save_stored_profile_edit();
+        Some(events)
+    }
