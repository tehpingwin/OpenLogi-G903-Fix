new file mode 100644
index 00000000..a3bdb28d
--- /dev/null
+++ b/crates/openlogi-desktop/src/state/stored_profiles.rs
@@ -0,0 +1,349 @@
+//! Editing a G-series mouse's stored profiles: the read, one edit buffer per
+//! mouse, saves, and making a profile active.
+//!
+//! The mouse is the only store: nothing here touches `config.toml`. A save
+//! sends the sector bytes the edit started from, and the agent refuses to
+//! write if the mouse no longer holds them, so an edit made on a stale read
+//! can't overwrite a change made meanwhile (in G HUB, say).
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+use gpui::Context;
+use openlogi_core::hid::{
+    ProfileIndex, StoredProfileSave, StoredProfileSettings, StoredProfiles, WriteError,
+};
+use tracing::{debug, warn};
+
+use super::{AppState, DeviceKey, DeviceRecord, Load, StateEvent, StateEvents};
+use crate::services::ipc::{ReadStoredProfiles, SaveStoredProfile, SelectStoredProfile};
+
+/// Read state of one mouse's stored profiles. See [`Load`].
+pub type StoredProfilesLoad = Load<Arc<StoredProfiles>>;
+
+/// How the last save or selection ended, for the editor to report.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum StoredProfileNotice {
+    /// Written and read back intact.
+    Saved,
+    /// The edit changed nothing.
+    NothingToSave,
+    /// The profile is active now.
+    Selected(ProfileIndex),
+    /// Refused or failed; the error says whether anything changed.
+    Failed(WriteError),
+}
+
+/// An edit in progress: the profile, its settings as edited, and the sector
+/// bytes they were read from.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct StoredProfileEdit {
+    /// The profile being edited.
+    pub index: ProfileIndex,
+    /// The settings as edited so far.
+    pub settings: StoredProfileSettings,
+    /// What the read held, to tell an edit from no edit.
+    pub original: StoredProfileSettings,
+    base: Vec<u8>,
+}
+
+impl StoredProfileEdit {
+    /// Whether anything differs from what the mouse holds.
+    #[must_use]
+    pub fn is_dirty(&self) -> bool {
+        self.settings != self.original
+    }
+}
+
+#[derive(Default)]
+struct Entry {
+    load: StoredProfilesLoad,
+    read_flight: u64,
+    edit: Option<StoredProfileEdit>,
+    saving: Option<u64>,
+    selecting: Option<ProfileIndex>,
+    notice: Option<StoredProfileNotice>,
+}
+
+/// Every mouse's stored-profile editor state.
+#[derive(Default)]
+pub(crate) struct StoredProfilesState {
+    entries: BTreeMap<DeviceKey, Entry>,
+    next_request: u64,
+}
+
+impl StoredProfilesState {
+    fn entry(&mut self, key: &DeviceKey) -> &mut Entry {
+        self.entries.entry(key.clone()).or_default()
+    }
+
+    fn next(&mut self) -> u64 {
+        self.next_request += 1;
+        self.next_request
+    }
+}
+
+fn load_from(result: Result<StoredProfiles, WriteError>) -> StoredProfilesLoad {
+    match result {
+        Ok(profiles) => Load::Ready(Arc::new(profiles)),
+        Err(error @ WriteError::FeatureUnsupported { .. }) => Load::Unsupported(error.to_string()),
+        Err(error) => Load::Failed(error.to_string()),
+    }
+}
+
+impl AppState {
+    fn stored_profile_target(&self) -> Option<(DeviceKey, openlogi_core::hid::DeviceRoute)> {
+        let record = self
+            .current_record()
+            .filter(|_| self.current_onboard_supported())?;
+        Some((record.device_key(), record.addressable_route()?.clone()))
+    }
+
+    /// The selected mouse's stored profiles, as last read.
+    #[must_use]
+    pub fn current_stored_profiles(&self) -> StoredProfilesLoad {
+        self.current_record()
+            .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))
+            .map(|entry| entry.load.clone())
+            .unwrap_or_default()
+    }
+
+    /// The selected mouse's edit in progress, if any.
+    #[must_use]
+    pub fn current_stored_profile_edit(&self) -> Option<&StoredProfileEdit> {
+        self.current_record()
+            .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))
+            .and_then(|entry| entry.edit.as_ref())
+    }
+
+    /// How the selected mouse's last save or selection ended.
+    #[must_use]
+    pub fn current_stored_profile_notice(&self) -> Option<&StoredProfileNotice> {
+        self.current_record()
+            .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))
+            .and_then(|entry| entry.notice.as_ref())
+    }
+
+    /// Whether a save or selection for the selected mouse is in flight.
+    #[must_use]
+    pub fn current_stored_profile_busy(&self) -> bool {
+        self.current_record()
+            .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))
+            .is_some_and(|entry| entry.saving.is_some() || entry.selecting.is_some())
+    }
+
+    /// Read the selected mouse's stored profiles if they haven't been read.
+    pub(super) fn load_current_stored_profiles(&mut self, cx: &mut Context<Self>) {
+        let Some((key, _)) = self.stored_profile_target() else {
+            return;
+        };
+        if matches!(self.stored_profiles.entry(&key).load, Load::Unknown) {
+            self.read_stored_profiles(cx);
+        }
+    }
+
+    /// Read the selected mouse's stored profiles again, discarding nothing:
+    /// an edit in progress stays until it is saved or dropped.
+    pub fn read_stored_profiles(&mut self, cx: &mut Context<Self>) {
+        let Some((key, route)) = self.stored_profile_target() else {
+            return;
+        };
+        let flight = self.stored_profiles.next();
+        let entry = self.stored_profiles.entry(&key);
+        entry.read_flight = flight;
+        if !matches!(entry.load, Load::Ready(_)) {
+            entry.load = Load::Loading;
+        }
+        let (reply, answer) = tokio::sync::oneshot::channel();
+        if !self.send_ipc(ReadStoredProfiles { route, reply }) {
+            self.stored_profiles.entry(&key).load =
+                Load::Failed(WriteError::AgentUnavailable.to_string());
+            return;
+        }
+        debug!(key = %key, "reading stored profiles");
+        cx.spawn(async move |state, cx| {
+            let result = answer.await.unwrap_or(Err(WriteError::AgentUnavailable));
+            let _ = state.update(cx, |state, cx| {
+                let entry = state.stored_profiles.entry(&key);
+                if entry.read_flight != flight {
+                    return; // a newer read is in flight
+                }
+                entry.load = load_from(result);
+                cx.emit(StateEvent::OnboardChanged(key.clone()));
+            });
+        })
+        .detach();
+    }
+
+    /// Start or continue editing profile `index` of the selected mouse, then
+    /// change its settings with `edit`.
+    pub fn edit_stored_profile(
+        &mut self,
+        index: ProfileIndex,
+        edit: impl FnOnce(&mut StoredProfileSettings),
+    ) -> StateEvents {
+        let events = self.for_current_device(StateEvent::OnboardChanged);
+        let Some(key) = self.current_record().map(DeviceRecord::device_key) else {
+            return events;
+        };
+        let entry = self.stored_profiles.entry(&key);
+        let Load::Ready(profiles) = &entry.load else {
+            return events;
+        };
+        if entry
+            .edit
+            .as_ref()
+            .is_none_or(|current| current.index != index)
+        {
+            let Some(slot) = profiles.profiles.iter().find(|slot| slot.index == index) else {
+                return events;
+            };
+            let Ok(settings) = &slot.settings else {
+                return events; // shown, but not editable
+            };
+            entry.edit = Some(StoredProfileEdit {
+                index,
+                settings: settings.clone(),
+                original: settings.clone(),
+                base: slot.base.clone(),
+            });
+        }
+        if let Some(current) = entry.edit.as_mut() {
+            edit(&mut current.settings);
+        }
+        entry.notice = None;
+        events
+    }
+
+    /// Drop the selected mouse's edit in progress.
+    pub fn discard_stored_profile_edit(&mut self) -> StateEvents {
+        let events = self.for_current_device(StateEvent::OnboardChanged);
+        if let Some(key) = self.current_record().map(DeviceRecord::device_key) {
+            let entry = self.stored_profiles.entry(&key);
+            entry.edit = None;
+            entry.notice = None;
+        }
+        events
+    }
+
+    /// Save the selected mouse's edit. The answer arrives as
+    /// [`Self::apply_stored_profile_saved`].
+    pub fn save_stored_profile_edit(&mut self) -> StateEvents {
+        let events = self.for_current_device(StateEvent::OnboardChanged);
+        let Some((key, route)) = self.stored_profile_target() else {
+            return events;
+        };
+        let request = self.stored_profiles.next();
+        let entry = self.stored_profiles.entry(&key);
+        let Some(edit) = entry.edit.clone().filter(StoredProfileEdit::is_dirty) else {
+            entry.notice = Some(StoredProfileNotice::NothingToSave);
+            return events;
+        };
+        if entry.saving.is_some() {
+            return events;
+        }
+        entry.saving = Some(request);
+        entry.notice = None;
+        if !self.send_ipc(SaveStoredProfile {
+            route,
+            key: key.clone(),
+            request,
+            index: edit.index,
+            base: edit.base,
+            settings: edit.settings,
+        }) {
+            let entry = self.stored_profiles.entry(&key);
+            entry.saving = None;
+            entry.notice = Some(StoredProfileNotice::Failed(WriteError::AgentUnavailable));
+        }
+        events
+    }
+
+    /// The agent's answer to a save: on success the edit is done and the
+    /// mouse is read again; on a refusal the edit stays, so nothing typed is
+    /// lost, and the mouse is read again in case it changed.
+    pub fn apply_stored_profile_saved(
+        &mut self,
+        key: &DeviceKey,
+        request: u64,
+        result: Result<StoredProfileSave, WriteError>,
+        cx: &mut Context<Self>,
+    ) {
+        let entry = self.stored_profiles.entry(key);
+        if entry.saving != Some(request) {
+            return; // an answer to a save this state no longer waits for
+        }
+        entry.saving = None;
+        entry.notice = Some(match result {
+            Ok(StoredProfileSave::Saved) => {
+                entry.edit = None;
+                StoredProfileNotice::Saved
+            }
+            Ok(StoredProfileSave::Unchanged) => {
+                entry.edit = None;
+                StoredProfileNotice::NothingToSave
+            }
+            Err(error) => {
+                warn!(%error, key = %key, "stored profile not saved");
+                if matches!(error, WriteError::OnboardMemoryChanged) {
+                    entry.edit = None; // its base is stale: the next read starts fresh
+                }
+                StoredProfileNotice::Failed(error)
+            }
+        });
+        cx.emit(StateEvent::OnboardChanged(key.clone()));
+        if self.is_current_device(key) {
+            self.read_stored_profiles(cx);
+        }
+    }
+
+    /// Make profile `index` the selected mouse's active profile. The answer
+    /// arrives as [`Self::apply_stored_profile_selected`].
+    pub fn select_stored_profile(&mut self, index: ProfileIndex) -> StateEvents {
+        let events = self.for_current_device(StateEvent::OnboardChanged);
+        let Some((key, route)) = self.stored_profile_target() else {
+            return events;
+        };
+        let entry = self.stored_profiles.entry(&key);
+        if entry.selecting.is_some() || entry.saving.is_some() {
+            return events;
+        }
+        entry.selecting = Some(index);
+        entry.notice = None;
+        if !self.send_ipc(SelectStoredProfile {
+            route,
+            key: key.clone(),
+            index,
+        }) {
+            let entry = self.stored_profiles.entry(&key);
+            entry.selecting = None;
+            entry.notice = Some(StoredProfileNotice::Failed(WriteError::AgentUnavailable));
+        }
+        events
+    }
+
+    /// The agent's answer to a selection; the mouse is read again either way.
+    pub fn apply_stored_profile_selected(
+        &mut self,
+        key: &DeviceKey,
+        index: ProfileIndex,
+        result: Result<(), WriteError>,
+        cx: &mut Context<Self>,
+    ) {
+        let entry = self.stored_profiles.entry(key);
+        if entry.selecting != Some(index) {
+            return;
+        }
+        entry.selecting = None;
+        entry.notice = Some(match result {
+            Ok(()) => StoredProfileNotice::Selected(index),
+            Err(error) => StoredProfileNotice::Failed(error),
+        });
+        cx.emit(StateEvent::OnboardChanged(key.clone()));
+        // OpenLogi's own onboard read (who is in control, the active profile) changed too.
+        self.pointer.reads.refresh_onboard(key);
+        if self.is_current_device(key) {
+            self.read_stored_profiles(cx);
+        }
+    }
+}
