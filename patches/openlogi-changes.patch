+#[gpui::test]
+fn a_lighting_change_goes_into_both_stored_lights(cx: &mut gpui::TestAppContext) {
+    let (_key, mut receiver) = ready(cx);
+    let _ = cx.update(|cx| {
+        AppState::update(cx, |state, _| {
+            let mut next = state.lighting();
+            next.enabled = true;
+            next.color = openlogi_core::color::Rgb::new(200, 100, 0);
+            next.brightness = 50;
+            state.commit_lighting(next)
+        })
+    });
+    let save = take_save(&mut receiver);
+    let expected = StoredLed::Fixed(openlogi_core::color::Rgb::new(100, 50, 0));
+    assert_eq!(
+        save.settings.leds, [expected; 2],
+        "brightness folded into the colour"
+    );
+    let shown = cx.read(|cx| AppState::try_read(cx).expect("state").lighting());
+    assert!(shown.enabled);
+    assert_eq!(
+        shown.color,
+        openlogi_core::color::Rgb::new(200, 100, 0),
+        "the colour as picked, not as dimmed"
+    );
+    assert_eq!(shown.brightness, 50);
+}
