+    #[must_use]
+    pub fn current_stored_profile_shown(&self) -> Option<ProfileIndex> {
+        let entry = self
+            .current_record()
+            .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))?;
+        let Load::Ready(profiles) = &entry.load else {
+            return None;
+        };
+        entry
