+//! The layout of a stored mouse profile (`0x8100` profile formats 1–5).
+//!
+//! The byte layout follows libratbag's `hidpp20_internal_profile`, which reads
+//! and writes it on real G-series mice; a G903 LIGHTSPEED HERO dump (format 4)
+//! matches it byte for byte. Only the fields below are decoded. Editing is
+//! read-modify-write: [`StoredProfile::encode_onto`] replaces only the fields
+//! that differ from the decoded original and copies every other byte through,
+//! so settings this module does not model (angle snapping, power timeouts,
+//! the profile name, …) survive. Rebuilding a sector from scratch, as
+//! libratbag does, drops them.
+
+use std::num::NonZeroU8;
+
+use crate::feature::color_led_effects::{EffectId, Rgb};
+
+/// Number of DPI levels a profile stores.
+pub const DPI_LEVELS: usize = 5;
+/// Number of lighting zones a profile stores.
+pub const LED_ZONES: usize = 2;
+
+const REPORT_RATE: usize = 0x00;
+const DEFAULT_DPI: usize = 0x01;
+const SHIFT_DPI: usize = 0x02;
+const DPI: usize = 0x03;
+const BUTTONS: usize = 0x20;
+const SHIFT_BUTTONS: usize = 0x60;
+const MAX_BUTTONS: usize = 16;
+const LEDS: [usize; LED_ZONES] = [0xd0, 0xdb];
+const POWER_SAVE_LEDS: [usize; LED_ZONES] = [0xe6, 0xf1];
+const LED_LEN: usize = 11;
+/// The last decoded byte is `0xfb`; the sector's last two bytes are its CRC.
+const MIN_SECTOR_LEN: usize = 0xfc + 2;
+const NO_SHIFT_LEVEL: u8 = 0xff;
+/// Half brightness: what G HUB stores for the power-saving copy, used when the
+/// copy's previous ratio to the visible effect is unknown.
+const DEFAULT_POWER_SAVE_PERCENT: u16 = 50;
+
+/// Why a sector can't be read or written as a profile.
+#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum ProfileError {
+    /// The device stores profiles in a layout this module does not know.
+    #[error("profile format {0} is not supported")]
+    UnsupportedFormat(u8),
+    /// The sector is too small to hold a profile.
+    #[error("the sector is too small to hold a profile")]
+    TooShort,
+    /// The stored checksum does not match the data.
+    #[error("the sector's checksum does not match")]
+    Checksum,
+    /// A field holds a value the layout does not allow.
+    #[error("{0}")]
+    Implausible(&'static str),
+}
+
+/// Whether profiles in `profile_format` can be decoded and written.
+#[must_use]
+pub const fn profile_format_supported(profile_format: u8) -> bool {
+    matches!(profile_format, 1..=5)
+}
+
+/// What a button does, as stored in its 4-byte binding.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub enum Binding {
+    /// Mouse button `1..=16` (1 left, 2 right, 3 middle, 4 back, 5 forward).
+    MouseButton(u8),
+    /// A keyboard key (HID usage page 7) with a boot-keyboard modifier byte.
+    Key {
+        /// Bit 0 left Ctrl, 1 left Shift, 2 left Alt, 3 left GUI; 4–7 the right ones.
+        modifiers: u8,
+        /// HID usage of the key.
+        usage: u8,
+    },
+    /// A consumer-control usage (media keys).
+    Consumer(u16),
+    /// A firmware function (DPI cycling, profile switching, …).
+    Special {
+        /// The function number.
+        function: u8,
+        /// The function's profile argument, kept as stored.
+        profile: u8,
+    },
+    /// A macro stored in onboard memory at `sector`, `offset`.
+    StoredMacro {
+        /// The macro's sector.
+        sector: u8,
+        /// The macro's byte offset in that sector.
+        offset: u8,
+    },
+    /// The button does nothing.
+    Disabled,
+    /// A binding this module does not decode, written back as it was.
+    Other([u8; 4]),
+}
+
+impl Binding {
+    /// Decodes a stored binding.
+    #[must_use]
+    pub fn decode(raw: [u8; 4]) -> Self {
+        match raw {
+            [0x80, 0x01, hi, lo] => {
+                let mask = u16::from_be_bytes([hi, lo]);
+                if mask.is_power_of_two() {
+                    // trailing_zeros of a non-zero u16 is at most 15
+                    Self::MouseButton(u8::try_from(mask.trailing_zeros()).map_or(0, |bit| bit + 1))
+                } else {
+                    Self::Other(raw)
+                }
+            }
+            [0x80, 0x02, modifiers, usage] => Self::Key { modifiers, usage },
+            [0x80, 0x03, hi, lo] => Self::Consumer(u16::from_be_bytes([hi, lo])),
+            [0x90, function, _, profile] => Self::Special { function, profile },
+            [0x00, sector, _, offset] => Self::StoredMacro { sector, offset },
+            [0xff, ..] => Self::Disabled,
+            _ => Self::Other(raw),
+        }
+    }
+
+    /// Encodes the binding. `StoredMacro`, `Other` and the special form keep
+    /// the layout they were decoded from.
+    #[must_use]
+    pub fn encode(self) -> [u8; 4] {
+        match self {
+            Self::MouseButton(n) => {
+                let [hi, lo] = 1u16
+                    .checked_shl(u32::from(n.saturating_sub(1)))
+                    .unwrap_or(0)
+                    .to_be_bytes();
+                [0x80, 0x01, hi, lo]
+            }
+            Self::Key { modifiers, usage } => [0x80, 0x02, modifiers, usage],
+            Self::Consumer(usage) => {
+                let [hi, lo] = usage.to_be_bytes();
+                [0x80, 0x03, hi, lo]
+            }
+            Self::Special { function, profile } => [0x90, function, 0x00, profile],
+            Self::StoredMacro { sector, offset } => [0x00, sector, 0x00, offset],
+            Self::Disabled => [0xff; 4],
+            Self::Other(raw) => raw,
+        }
+    }
+
+    fn valid(self) -> bool {
+        match self {
+            Self::MouseButton(n) => (1..=16).contains(&n),
+            Self::Key { usage, .. } => (0x04..=0xe7).contains(&usage),
+            _ => true,
+        }
+    }
+}
+
+/// A lighting zone's effect, in the 11-byte layout `0x8070` effects share.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub enum LedEffect {
+    /// The zone is dark.
+    Off,
+    /// A fixed colour.
+    Fixed(Rgb),
+    /// Breathing in one colour.
+    Breathing {
+        /// The colour.
+        color: Rgb,
+        /// One breath, in milliseconds.
+        period_ms: u16,
+        /// `1..=100`.
+        brightness: u8,
+    },
+    /// Cycling through the colour wheel.
+    Cycle {
+        /// One cycle, in milliseconds.
+        period_ms: u16,
+        /// `1..=100`.
+        brightness: u8,
+    },
+    /// An effect this module does not decode, written back as it was.
+    Other([u8; LED_LEN]),
+}
+
+const FIXED: u8 = EffectId::FixedColor as u8;
+const CYCLE: u8 = EffectId::Cycling as u8;
+const BREATHING: u8 = EffectId::PulsingBreathingWaveform as u8;
+const OFF: u8 = EffectId::Disabled as u8;
+
+/// A stored intensity of 0 means full brightness.
+fn brightness_from(stored: u8) -> u8 {
+    if stored == 0 { 100 } else { stored.min(100) }
+}
+fn brightness_to(percent: u8) -> u8 {
+    if percent >= 100 { 0 } else { percent.max(1) }
+}
+
+impl LedEffect {
+    fn decode(raw: &[u8]) -> Self {
+        let mut bytes = [0; LED_LEN];
+        bytes.copy_from_slice(&raw[..LED_LEN]);
+        let p = &bytes[1..];
+        let rgb = |at: usize| Rgb {
+            red: p[at],
+            green: p[at + 1],
+            blue: p[at + 2],
+        };
+        match bytes[0] {
+            OFF => Self::Off,
+            FIXED => Self::Fixed(rgb(0)),
+            BREATHING => Self::Breathing {
+                color: rgb(0),
+                period_ms: u16::from_be_bytes([p[3], p[4]]),
+                brightness: brightness_from(p[6]),
+            },
+            CYCLE => Self::Cycle {
+                period_ms: u16::from_be_bytes([p[5], p[6]]),
+                brightness: brightness_from(p[7]),
+            },
+            _ => Self::Other(bytes),
+        }
+    }
+
+    fn encode(self) -> [u8; LED_LEN] {
+        let mut b = [0; LED_LEN];
+        match self {
+            Self::Off => b[0] = OFF,
+            Self::Fixed(c) => b[..4].copy_from_slice(&[FIXED, c.red, c.green, c.blue]),
+            Self::Breathing {
+                color,
+                period_ms,
+                brightness,
+            } => {
+                let [hi, lo] = period_ms.to_be_bytes();
+                b[..6].copy_from_slice(&[BREATHING, color.red, color.green, color.blue, hi, lo]);
+                b[7] = brightness_to(brightness);
+            }
+            Self::Cycle {
+                period_ms,
+                brightness,
+            } => {
+                let [hi, lo] = period_ms.to_be_bytes();
+                b[0] = CYCLE;
+                b[6] = hi;
+                b[7] = lo;
+                b[8] = brightness_to(brightness);
+            }
+            Self::Other(raw) => b = raw,
+        }
+        b
+    }
+
+    /// The brightness percentage, where the effect has one (a fixed colour's
+    /// brightness lives in the colour itself).
+    #[must_use]
+    pub const fn brightness(self) -> Option<u8> {
+        match self {
+            Self::Breathing { brightness, .. } | Self::Cycle { brightness, .. } => Some(brightness),
+            _ => None,
+        }
+    }
+
+    /// The same effect at `ratio_percent` of its brightness, for the
+    /// power-saving copy. A fixed colour is dimmed in its channels.
+    #[must_use]
+    pub fn dimmed(self, ratio_percent: u16) -> Self {
+        let scale = |v: u8| u8::try_from(u16::from(v) * ratio_percent.min(100) / 100).unwrap_or(v);
+        match self {
+            Self::Fixed(c) => Self::Fixed(Rgb {
+                red: scale(c.red),
+                green: scale(c.green),
+                blue: scale(c.blue),
+            }),
+            Self::Breathing {
+                color,
+                period_ms,
+                brightness,
+            } => Self::Breathing {
+                color,
+                period_ms,
+                brightness: scale(brightness).max(1),
+            },
+            Self::Cycle {
+                period_ms,
+                brightness,
+            } => Self::Cycle {
+                period_ms,
+                brightness: scale(brightness).max(1),
+            },
+            other => other,
+        }
+    }
+}
+
+/// The decoded fields of a stored mouse profile.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub struct StoredProfile {
+    /// Report interval in milliseconds: 1, 2, 4 or 8 (1000/500/250/125 Hz).
+    pub report_interval_ms: u8,
+    /// Index into `dpi` of the level the profile starts at.
+    pub default_dpi_level: u8,
+    /// Index into `dpi` of the DPI-shift level, if any.
+    pub shift_dpi_level: Option<u8>,
+    /// DPI per level; `0` marks an unused level.
+    pub dpi: [u16; DPI_LEVELS],
+    /// The visible lighting per zone.
+    pub leds: [LedEffect; LED_ZONES],
+    /// The copy the mouse shows while saving power.
+    pub power_save_leds: [LedEffect; LED_ZONES],
+    /// One binding per button.
+    pub buttons: Vec<Binding>,
+    /// The second (G-Shift) layer. Always read and kept, even when the
+    /// layout flags don't announce G-Shift: G HUB fills it anyway.
+    pub shift_buttons: Vec<Binding>,
+}
+
+impl StoredProfile {
+    /// Decodes `sector`, refusing anything that does not look like a profile
+    /// in the documented layout.
+    pub fn decode(
+        sector: &[u8],
+        profile_format: u8,
+        button_count: u8,
+        dpi_range: (u16, u16),
+    ) -> Result<Self, ProfileError> {
+        if !profile_format_supported(profile_format) {
+            return Err(ProfileError::UnsupportedFormat(profile_format));
+        }
+        if sector.len() < MIN_SECTOR_LEN {
+            return Err(ProfileError::TooShort);
+        }
+        if !sector_checksum_ok(sector) {
+            return Err(ProfileError::Checksum);
+        }
+        let report_interval_ms = sector[REPORT_RATE];
+        if !matches!(report_interval_ms, 1 | 2 | 4 | 8) {
+            return Err(ProfileError::Implausible("unexpected report rate"));
+        }
+        let default_dpi_level = sector[DEFAULT_DPI];
+        if usize::from(default_dpi_level) >= DPI_LEVELS {
+            return Err(ProfileError::Implausible("unexpected default DPI level"));
+        }
+        let shift_dpi_level = match sector[SHIFT_DPI] {
+            NO_SHIFT_LEVEL => None,
+            level if usize::from(level) < DPI_LEVELS => Some(level),
+            _ => return Err(ProfileError::Implausible("unexpected DPI shift level")),
+        };
+        let mut dpi = [0; DPI_LEVELS];
+        for (i, level) in dpi.iter_mut().enumerate() {
+            let at = DPI + 2 * i;
+            let value = u16::from_le_bytes([sector[at], sector[at + 1]]);
+            *level = if value == 0xffff { 0 } else { value };
+            if *level != 0 && !(dpi_range.0..=dpi_range.1).contains(level) {
+                return Err(ProfileError::Implausible(
+                    "a DPI level is outside the sensor's range",
+                ));
+            }
+        }
+        if dpi[usize::from(default_dpi_level)] == 0 {
+            return Err(ProfileError::Implausible("the default DPI level is unused"));
+        }
+        let count = usize::from(button_count).min(MAX_BUTTONS);
+        let bindings = |base: usize| -> Vec<Binding> {
+            (0..count)
+                .map(|i| {
+                    let at = base + 4 * i;
+                    Binding::decode([sector[at], sector[at + 1], sector[at + 2], sector[at + 3]])
+                })
+                .collect()
+        };
+        Ok(Self {
+            report_interval_ms,
+            default_dpi_level,
+            shift_dpi_level,
+            dpi,
+            leds: LEDS.map(|at| LedEffect::decode(&sector[at..])),
+            power_save_leds: POWER_SAVE_LEDS.map(|at| LedEffect::decode(&sector[at..])),
+            buttons: bindings(BUTTONS),
+            shift_buttons: bindings(SHIFT_BUTTONS),
+        })
+    }
+
+    /// Checks an edited profile before it is encoded.
+    pub fn validate(&self, dpi_range: (u16, u16), dpi_step: u16) -> Result<(), ProfileError> {
+        if !matches!(self.report_interval_ms, 1 | 2 | 4 | 8) {
+            return Err(ProfileError::Implausible("unsupported report rate"));
+        }
+        let mut used = 0;
+        for &level in &self.dpi {
+            if level == 0 {
+                continue;
+            }
+            if !(dpi_range.0..=dpi_range.1).contains(&level) {
+                return Err(ProfileError::Implausible(
+                    "a DPI level is outside the sensor's range",
+                ));
+            }
+            if dpi_step > 0 && !(level - dpi_range.0).is_multiple_of(dpi_step) {
+                return Err(ProfileError::Implausible(
+                    "a DPI level is not a multiple of the sensor's step",
+                ));
+            }
+            used += 1;
+        }
+        if used == 0 {
+            return Err(ProfileError::Implausible("no DPI level is used"));
+        }
+        let level_used = |level: u8| self.dpi.get(usize::from(level)).is_some_and(|&v| v != 0);
+        if !level_used(self.default_dpi_level) {
+            return Err(ProfileError::Implausible("the default DPI level is unused"));
+        }
+        if self.shift_dpi_level.is_some_and(|level| !level_used(level)) {
+            return Err(ProfileError::Implausible("the DPI shift level is unused"));
+        }
+        if !self.buttons.is_empty() && !self.buttons.contains(&Binding::MouseButton(1)) {
+            return Err(ProfileError::Implausible("no button is left click"));
+        }
+        if !self
+            .buttons
+            .iter()
+            .chain(&self.shift_buttons)
+            .all(|b| b.valid())
+        {
+            return Err(ProfileError::Implausible(
+                "a button has an invalid assignment",
+            ));
+        }
+        for led in &self.leds {
+            if let LedEffect::Breathing {
+                period_ms,
+                brightness,
+                ..
+            }
+            | LedEffect::Cycle {
+                period_ms,
+                brightness,
+            } = *led
+                && (!(500..=20_000).contains(&period_ms) || !(1..=100).contains(&brightness))
+            {
+                return Err(ProfileError::Implausible(
+                    "an effect's speed or brightness is out of range",
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    /// `original` with only the fields where `self` differs from `before`
+    /// (the profile decoded from `original`) replaced, checksum renewed.
+    ///
+    /// A zone whose visible effect changed gets its power-saving copy
+    /// rewritten too: the same effect, dimmed by the ratio the copy had before
+    /// (half when that ratio is unknown), so the mouse keeps dimming.
+    pub fn encode_onto(&self, original: &[u8], before: &Self) -> Result<Vec<u8>, ProfileError> {
+        if original.len() < MIN_SECTOR_LEN {
+            return Err(ProfileError::TooShort);
+        }
+        let mut s = original.to_vec();
+        if self.report_interval_ms != before.report_interval_ms {
+            s[REPORT_RATE] = self.report_interval_ms;
+        }
+        if self.default_dpi_level != before.default_dpi_level {
+            s[DEFAULT_DPI] = self.default_dpi_level;
+        }
+        if self.shift_dpi_level != before.shift_dpi_level {
+            s[SHIFT_DPI] = self.shift_dpi_level.unwrap_or(NO_SHIFT_LEVEL);
+        }
+        for i in 0..DPI_LEVELS {
+            if self.dpi[i] != before.dpi[i] {
+                let at = DPI + 2 * i;
+                s[at..at + 2].copy_from_slice(&self.dpi[i].to_le_bytes());
+            }
+        }
+        for zone in 0..LED_ZONES {
+            if self.leds[zone] == before.leds[zone] {
+                continue;
+            }
+            s[LEDS[zone]..LEDS[zone] + LED_LEN].copy_from_slice(&self.leds[zone].encode());
+            let ratio = match (
+                before.leds[zone].brightness(),
+                before.power_save_leds[zone].brightness(),
+            ) {
+                (Some(shown), Some(saving)) if shown > 0 => {
+                    u16::from(saving) * 100 / u16::from(shown)
+                }
+                _ => DEFAULT_POWER_SAVE_PERCENT,
+            };
+            let saving = self.leds[zone].dimmed(ratio);
+            s[POWER_SAVE_LEDS[zone]..POWER_SAVE_LEDS[zone] + LED_LEN]
+                .copy_from_slice(&saving.encode());
+        }
+        for (base, now, was) in [
+            (BUTTONS, &self.buttons, &before.buttons),
+            (SHIFT_BUTTONS, &self.shift_buttons, &before.shift_buttons),
+        ] {
+            for (i, (a, b)) in now.iter().zip(was.iter()).enumerate().take(MAX_BUTTONS) {
+                if a != b {
+                    let at = base + 4 * i;
+                    s[at..at + 4].copy_from_slice(&a.encode());
+                }
+            }
+        }
+        seal_sector(&mut s);
+        Ok(s)
+    }
+}
+
+/// CRC-16/CCITT-FALSE, the checksum in the last two bytes of a user sector.
+#[must_use]
+pub fn crc16(data: &[u8]) -> u16 {
+    let mut crc: u16 = 0xffff;
+    for &byte in data {
+        crc ^= u16::from(byte) << 8;
+        for _ in 0..8 {
+            crc = if crc & 0x8000 != 0 {
+                (crc << 1) ^ 0x1021
+            } else {
+                crc << 1
+            };
+        }
+    }
+    crc
+}
+
+/// Whether the sector's stored checksum matches its data.
+#[must_use]
+pub fn sector_checksum_ok(sector: &[u8]) -> bool {
+    let Some(split) = sector.len().checked_sub(2) else {
+        return false;
+    };
+    u16::from_be_bytes([sector[split], sector[split + 1]]) == crc16(&sector[..split])
+}
+
+/// Writes the checksum of the sector's data into its last two bytes.
+pub fn seal_sector(sector: &mut [u8]) {
+    if let Some(split) = sector.len().checked_sub(2) {
+        let crc = crc16(&sector[..split]).to_be_bytes();
+        sector[split..].copy_from_slice(&crc);
+    }
+}
+
+/// The profile directory `dir` with profile `index` switched on, checksum
+/// renewed. Only that entry's flag byte changes. Refuses a directory whose
+/// entry for `index` doesn't point at `sector`.
+pub fn directory_with_enabled(
+    dir: &[u8],
+    index: NonZeroU8,
+    sector: u16,
+) -> Result<Vec<u8>, ProfileError> {
+    let entry = 4 * usize::from(index.get() - 1);
+    if entry + 3 >= dir.len().saturating_sub(2) {
+        return Err(ProfileError::TooShort);
+    }
+    if !sector_checksum_ok(dir) {
+        return Err(ProfileError::Checksum);
+    }
+    if u16::from_be_bytes([dir[entry], dir[entry + 1]]) != sector {
+        return Err(ProfileError::Implausible(
+            "the profile list doesn't point at that profile",
+        ));
+    }
+    let mut out = dir.to_vec();
+    out[entry + 2] = 0x01;
+    seal_sector(&mut out);
+    Ok(out)
+}
+
+/// One step of a macro stored in onboard memory (macro format 1).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize))]
+pub enum MacroStep {
+    /// Key press: modifiers and HID usage.
+    KeyDown(u8, u8),
+    /// Key release.
+    KeyUp(u8, u8),
+    /// Wait, in milliseconds.
+    Delay(u16),
+}
+
+/// Why a stored macro can't be read.
+#[derive(Clone, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum MacroError {
+    /// A sector it uses couldn't be read.
+    #[error("its memory couldn't be read")]
+    Unreadable,
+    /// It runs past the end of its sector.
+    #[error("it is cut short")]
+    Truncated,
+    /// It uses a step this module does not know.
+    #[error("it uses an unknown step {0:#04x}")]
+    UnknownStep(u8),
+    /// It never ends, or jumps too often.
+    #[error("it does not end")]
+    Endless,
+}
+
+/// Reads the macro starting at `offset` in `sector`. `read` returns a
+/// sector's bytes. Steps seen on a G903 HERO: `43 mods usage` press,
+/// `44 mods usage` release, `40 ms(BE16)` wait, `60 offset sector` continue
+/// elsewhere, `00` no-op, `ff` end.
+pub fn read_stored_macro(
+    mut sector: u8,
+    mut offset: usize,
+    mut read: impl FnMut(u8) -> Option<Vec<u8>>,
+) -> Result<Vec<MacroStep>, MacroError> {
+    let mut steps = Vec::new();
+    let mut data = read(sector).ok_or(MacroError::Unreadable)?;
+    let mut jumps = 0;
+    for _ in 0..1024 {
+        let byte = |at: usize| data.get(at).copied().ok_or(MacroError::Truncated);
+        match byte(offset)? {
+            0xff => return Ok(steps),
+            0x00 => offset += 1,
+            kind @ (0x43 | 0x44) => {
+                let (mods, usage) = (byte(offset + 1)?, byte(offset + 2)?);
+                steps.push(if kind == 0x43 {
+                    MacroStep::KeyDown(mods, usage)
+                } else {
+                    MacroStep::KeyUp(mods, usage)
+                });
+                offset += 3;
+            }
+            0x40 => {
+                steps.push(MacroStep::Delay(u16::from_be_bytes([
+                    byte(offset + 1)?,
+                    byte(offset + 2)?,
+                ])));
+                offset += 3;
+            }
+            0x60 => {
+                jumps += 1;
+                if jumps > 16 {
+                    return Err(MacroError::Endless);
+                }
+                let (next_offset, next_sector) = (byte(offset + 1)?, byte(offset + 2)?);
+                if next_sector != sector {
+                    sector = next_sector;
+                    data = read(sector).ok_or(MacroError::Unreadable)?;
+                }
+                offset = usize::from(next_offset);
+            }
+            other => return Err(MacroError::UnknownStep(other)),
+        }
+    }
+    Err(MacroError::Endless)
+}
