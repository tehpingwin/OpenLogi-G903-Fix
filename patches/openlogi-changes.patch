From 8eb9887b864a64d0c27a48dd1cb290cb8a9f35a2 Mon Sep 17 00:00:00 2001
From: OpenLogi contributor <contributor@localhost>
Date: Wed, 25 Nov 2026 22:06:04 +0000
Subject: [PATCH 19/19] feat(agent): the Windows tray keeps a device's last
 battery when it is offline

An offline device read "Name: Offline". It now reads "Name: 56%
(Offline)" with the last battery it reported, remembered across agent
runs in state_dir()/tray-battery.json (a device asleep since before the
agent started has no reading in the snapshot).
---
 crates/openlogi-agent/src/tray_windows.rs | 82 ++++++++++++++++++++---
 1 file changed, 74 insertions(+), 8 deletions(-)

diff --git a/crates/openlogi-agent/src/tray_windows.rs b/crates/openlogi-agent/src/tray_windows.rs
index 696b0a39..b2f2a318 100644
--- a/crates/openlogi-agent/src/tray_windows.rs
+++ b/crates/openlogi-agent/src/tray_windows.rs
@@ -25,9 +25,12 @@
     reason = "raw win32: Shell_NotifyIconW + a hidden window's message pump — localized here"
 )]
 use std::cell::RefCell;
+use std::collections::HashMap;
 use std::sync::atomic::{AtomicU32, AtomicUsize, Ordering};
 use std::sync::{Arc, Mutex, OnceLock};
 
+use openlogi_core::device::BatteryInfo;
+
 use openlogi_agent_core::observable::ObservableState;
 use openlogi_core::config::Config;
 use openlogi_ipc::Observation;
@@ -66,6 +69,10 @@ static OBSERVABLE: OnceLock<Arc<ObservableState>> = OnceLock::new();
 static CONFIG: Mutex<Option<Arc<Config>>> = Mutex::new(None);
 /// The tray window, once made (`0` before), for posting refreshes to.
 static TRAY_HWND: AtomicUsize = AtomicUsize::new(0);
+/// Each device's last battery reading, by its device link, so a device that
+/// is offline (even since before the agent started) still shows it.
+static LAST_BATTERY: Mutex<Option<HashMap<String, BatteryInfo>>> = Mutex::new(None);
+const LAST_BATTERY_FILE: &str = "tray-battery.json";
 /// Menu command ids returned by `TrackPopupMenu`.
 const ID_SHOW: usize = 1;
 const ID_QUIT: usize = 2;
@@ -453,8 +460,11 @@ pub async fn watch_devices(mut changes: watch::Receiver<Observation>) {
     }
 }
 
-/// One line per device: its name and battery (or that it is offline).
+/// One line per device: its name and battery, and "(Offline)" for a device
+/// out of reach, with the last battery it reported.
 fn device_lines() -> Vec<String> {
+    use crate::tray_model::{DeviceState, battery_text};
+
     let Some(observable) = OBSERVABLE.get() else {
         return Vec::new();
     };
@@ -463,22 +473,78 @@ fn device_lines() -> Vec<String> {
         .ok()
         .and_then(|config| config.clone())
         .unwrap_or_default();
-    crate::tray_model::TrayMenu::new(&observable.snapshot(), &config)
-        .devices
+    let rows = crate::tray_model::TrayMenu::new(&observable.snapshot(), &config).devices;
+    let Ok(mut remembered) = LAST_BATTERY.lock() else {
+        return Vec::new();
+    };
+    let last = remembered.get_or_insert_with(load_last_battery);
+    let mut changed = false;
+    let offline = rust_i18n::t!("tray.offline");
+    let lines = rows
         .iter()
         .map(|row| {
-            use crate::tray_model::DeviceState;
+            let key = format!("{:?}", row.settings);
             match &row.state {
                 DeviceState::Battery(battery) => {
-                    format!("{}: {}", row.name, crate::tray_model::battery_text(battery))
+                    changed |= remember(last, &key, battery);
+                    format!("{}: {}", row.name, battery_text(battery))
                 }
-                DeviceState::Offline(_) => {
-                    format!("{}: {}", row.name, rust_i18n::t!("tray.offline"))
+                DeviceState::Offline(Some(battery)) => {
+                    changed |= remember(last, &key, battery);
+                    format!("{}: {} ({offline})", row.name, battery_text(battery))
                 }
+                DeviceState::Offline(None) => match last.get(&key) {
+                    Some(battery) => format!("{}: {} ({offline})", row.name, battery_text(battery)),
+                    None => format!("{}: {offline}", row.name),
+                },
                 DeviceState::Light(_) | DeviceState::Online => row.name.clone(),
             }
         })
-        .collect()
+        .collect();
+    if changed {
+        save_last_battery(last);
+    }
+    lines
+}
+
+/// Keep `battery` as `key`'s last reading; whether that changed anything.
+fn remember(last: &mut HashMap<String, BatteryInfo>, key: &str, battery: &BatteryInfo) -> bool {
+    if last.get(key) == Some(battery) {
+        return false;
+    }
+    last.insert(key.to_owned(), battery.clone());
+    true
+}
+
+fn last_battery_path() -> Option<std::path::PathBuf> {
+    openlogi_core::paths::state_dir()
+        .ok()
+        .map(|dir| dir.join(LAST_BATTERY_FILE))
+}
+
+/// The readings saved by an earlier run; empty when there are none.
+fn load_last_battery() -> HashMap<String, BatteryInfo> {
+    last_battery_path()
+        .and_then(|path| std::fs::read(path).ok())
+        .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+        .unwrap_or_default()
+}
+
+fn save_last_battery(last: &HashMap<String, BatteryInfo>) {
+    let Some(path) = last_battery_path() else {
+        return;
+    };
+    let saved = path
+        .parent()
+        .map_or(Ok(()), std::fs::create_dir_all)
+        .and_then(|()| {
+            serde_json::to_vec(last)
+                .map_err(std::io::Error::other)
+                .and_then(|bytes| std::fs::write(&path, bytes))
+        });
+    if let Err(error) = saved {
+        warn!(%error, "could not save the tray's last battery readings");
+    }
 }
 
 /// "OpenLogi", then each device on its own line.
