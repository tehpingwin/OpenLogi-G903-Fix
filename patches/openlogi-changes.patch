+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicU8, Ordering};
+use std::sync::{Arc, Mutex};
+
+use super::*;
+use crate::channel::scripted::{ScriptedRawHidChannel, feature_error, scripted_channel};
+
+include!("fixtures.rs");
+
+const ONBOARD: u8 = 8;
+const GET_INFO: u8 = 0;
+const SET_MODE: u8 = 1;
+const GET_MODE: u8 = 2;
+const SET_CURRENT: u8 = 3;
+const GET_CURRENT: u8 = 4;
+const READ: u8 = 5;
+const ADDR_WRITE: u8 = 6;
+const WRITE: u8 = 7;
+const WRITE_END: u8 = 8;
+const INVALID_ARGUMENT: u8 = 2;
+const HW_ERROR: u8 = 4;
+
+/// A write in progress: sector, announced length, data received so far.
+type PendingWrite = Arc<Mutex<(u16, usize, Vec<u8>)>>;
+/// Every backup taken: sector and the bytes saved.
+type Backups = Arc<Mutex<Vec<(u16, Vec<u8>)>>>;
+
+/// A scripted G903 HERO: `0x8100` at [`ONBOARD`] with its real sectors, and
+/// no DPI feature (so DPI edits are refused).
+#[derive(Clone, Default)]
+struct Mouse {
+    memory: Arc<Mutex<HashMap<u16, Vec<u8>>>>,
+    current: Arc<AtomicU8>,
+    /// The first write stores a corrupted byte.
+    store_wrong: Arc<AtomicBool>,
+    /// The write end call fails.
+    fail_end: Arc<AtomicBool>,
+    pending: PendingWrite,
+    writes: Arc<Mutex<Vec<u16>>>,
+}
+
+impl Mouse {
+    fn g903() -> Self {
+        let mouse = Self::default();
+        {
+            let mut memory = mouse.memory.lock().unwrap();
+            memory.insert(0x0000, DIRECTORY.to_vec());
+            memory.insert(0x0001, EDITED.to_vec());
+            for sector in 2..=5 {
+                memory.insert(sector, FACTORY.to_vec());
+            }
+            memory.insert(0x0006, MACROS.to_vec());
+            let mut rom = FACTORY.to_vec();
+            rom[253] = 0xff; // ROM sectors carry no checksum
+            rom[254] = 0xff;
+            memory.insert(0x0101, rom);
+        }
+        mouse.current.store(1, Ordering::SeqCst);
+        mouse
+    }
+
+    fn sector(&self, sector: u16) -> Vec<u8> {
+        self.memory.lock().unwrap()[&sector].clone()
+    }
+
+    fn responder(self) -> impl Fn(&[u8]) -> Option<Vec<u8>> {
+        move |request| {
+            let mut response = vec![0; 20];
+            response[..4].copy_from_slice(&request[..4]);
+            response[0] = 0x11;
+            // short (7-byte) requests carry 3 parameter bytes; pad to the long form
+            let mut padded = request.to_vec();
+            padded.resize(20, 0);
+            let args = &padded[4..20];
+            match (request[2], request[3] >> 4) {
+                (0, 1) => response[4] = 4,
+                (0, 0) => {
+                    response[4] = if u16::from_be_bytes([args[0], args[1]]) == 0x8100 {
+                        ONBOARD
+                    } else {
+                        0
+                    };
+                }
+                (ONBOARD, GET_INFO) => {
+                    response[4..15]
+                        .copy_from_slice(&[1, 4, 1, 5, 1, 12, 16, 0x00, 0xff, 0x10, 0x04]);
+                }
+                (ONBOARD, GET_MODE) => response[4] = 1,
+                (ONBOARD, SET_MODE) => {}
+                (ONBOARD, GET_CURRENT) => response[5] = self.current.load(Ordering::SeqCst),
+                (ONBOARD, SET_CURRENT) => {
+                    let wanted = args[1];
+                    let dir = self.sector(0);
+                    let entry = usize::from(wanted.saturating_sub(1)) * 4;
+                    if wanted == 0 || dir.get(entry + 2) != Some(&1) {
+                        return Some(feature_error(request, INVALID_ARGUMENT)); // like the real mouse
+                    }
+                    self.current.store(wanted, Ordering::SeqCst);
+                }
+                (ONBOARD, READ) => {
+                    let sector = u16::from_be_bytes([args[0], args[1]]);
+                    let offset = usize::from(u16::from_be_bytes([args[2], args[3]]));
+                    let memory = self.memory.lock().unwrap();
+                    let Some(data) = memory.get(&sector) else {
+                        return Some(feature_error(request, INVALID_ARGUMENT));
+                    };
+                    if offset + 16 > data.len() {
+                        return Some(feature_error(request, INVALID_ARGUMENT));
+                    }
+                    response[4..20].copy_from_slice(&data[offset..offset + 16]);
+                }
+                (ONBOARD, ADDR_WRITE) => {
+                    let sector = u16::from_be_bytes([args[0], args[1]]);
+                    let len = usize::from(u16::from_be_bytes([args[4], args[5]]));
+                    *self.pending.lock().unwrap() = (sector, len, Vec::new());
+                }
+                (ONBOARD, WRITE) => self.pending.lock().unwrap().2.extend_from_slice(args),
+                (ONBOARD, WRITE_END) => {
+                    if self.fail_end.load(Ordering::SeqCst) {
+                        return Some(feature_error(request, HW_ERROR));
+                    }
+                    let (sector, len, mut data) = self.pending.lock().unwrap().clone();
+                    data.truncate(len);
+                    if self.store_wrong.swap(false, Ordering::SeqCst) {
+                        data[5] ^= 0x01;
+                    }
+                    self.memory.lock().unwrap().insert(sector, data);
+                    self.writes.lock().unwrap().push(sector);
+                }
+                _ => return None,
+            }
+            Some(response)
+        }
+    }
+}
+
+struct Rig {
+    mouse: Mouse,
+    channel: Arc<HidppChannel>,
+    backups: Backups,
+}
+
+impl Rig {
+    async fn new() -> Self {
+        let mouse = Mouse::g903();
+        let (raw, _handle) =
+            ScriptedRawHidChannel::with_dynamic_responder(mouse.clone().responder());
+        let channel = scripted_channel(raw).await;
+        Self {
+            mouse,
+            channel,
+            backups: Arc::default(),
+        }
+    }
+
+    fn backup(&self) -> impl Fn(u16, &[u8]) -> bool + Send + Sync + 'static {
+        let backups = Arc::clone(&self.backups);
+        move |sector, data| {
+            backups.lock().unwrap().push((sector, data.to_vec()));
+            true
+        }
+    }
+
+    async fn read(&self) -> StoredProfiles {
+        read_stored_profiles_on_channel(&self.channel, 0xff)
+            .await
+            .unwrap()
+    }
+
+    async fn save(
+        &self,
+        profile: u8,
+        edit: impl FnOnce(&mut StoredProfile),
+    ) -> Result<SaveOutcome, WriteError> {
+        let read = self.read().await;
+        let slot = read
+            .profiles
+            .iter()
+            .find(|s| s.index.get() == profile)
+            .unwrap();
+        let before = slot.decoded.clone().unwrap();
+        let mut after = before.clone();
+        edit(&mut after);
+        let backup = self.backup();
+        save_stored_profile_on_channel(
+            &self.channel,
+            0xff,
+            slot.index,
+            &slot.raw,
+            &before,
+            &after,
+            &backup,
+        )
+        .await
+    }
+}
+
+fn nz(n: u8) -> NonZeroU8 {
+    NonZeroU8::new(n).unwrap()
+}
+
+#[tokio::test]
+async fn reads_profiles_factory_buttons_and_macros() {
+    let rig = Rig::new().await;
+    let read = rig.read().await;
+    assert_eq!(read.active, Some(nz(1)));
