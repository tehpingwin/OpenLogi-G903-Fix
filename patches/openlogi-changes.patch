+            gpui_kit::component::setting::NumberFieldOptions {
+                min: 1.0,
+                max: 95.0,
+                step: 5.0,
+            },
+            |cx| {
+                AppState::try_read(cx).map_or(20.0, |s| {
+                    f64::from(s.app_settings().low_battery_warn_percent)
+                })
+            },
+            |value, cx| {
+                AppState::apply(cx, |state| {
+                    let rearm = state.app_settings().low_battery_rearm_percent;
+                    state.commit_low_battery_levels(percent(value), rearm)
+                });
+            },
+        ),
+    )
+    .description(tr!("app.low_battery_warn_at_description"))
+}
+
+/// The charge a device must reach before its next low battery is announced.
+fn low_battery_rearm_item() -> SettingItem {
+    SettingItem::new(
+        tr!("app.low_battery_rearm_at"),
+        SettingField::number_input(
+            gpui_kit::component::setting::NumberFieldOptions {
+                min: 2.0,
+                max: 100.0,
+                step: 5.0,
+            },
+            |cx| {
+                AppState::try_read(cx).map_or(30.0, |s| {
+                    f64::from(s.app_settings().low_battery_rearm_percent)
+                })
+            },
+            |value, cx| {
+                AppState::apply(cx, |state| {
+                    let warn = state.app_settings().low_battery_warn_percent;
+                    state.commit_low_battery_levels(warn, percent(value))
+                });
+            },
+        ),
+    )
+    .description(tr!("app.low_battery_rearm_at_description"))
+}
+
+/// A number field's value as a whole percentage.
+#[expect(
+    clippy::cast_possible_truncation,
+    clippy::cast_sign_loss,
+    reason = "clamped to 0..=100 first"
+)]
+fn percent(value: f64) -> u8 {
+    value.clamp(0.0, 100.0).round() as u8
+}
