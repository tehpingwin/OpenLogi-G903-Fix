+/// Hand the tray the agent's state, so its tooltip and menu list devices.
+pub fn set_observable(observable: Arc<ObservableState>) {
+    let _ = OBSERVABLE.set(observable);
+    request_refresh();
+}
+
+/// Give the tray the current config (device names and order).
+pub fn set_config(config: Arc<Config>) {
+    if let Ok(mut current) = CONFIG.lock() {
+        *current = Some(config);
+    }
+    request_refresh();
+}
+
+/// Ask the tray thread to re-send its tooltip.
+fn request_refresh() {
+    let hwnd = TRAY_HWND.load(Ordering::Acquire);
+    if hwnd != 0 {
+        // SAFETY: posting to a window of this process; a stale handle just
+        // makes the post fail.
+        unsafe { PostMessageW(hwnd as HWND, WM_REFRESH, 0, 0) };
+    }
+}
+
+/// Refresh the tooltip whenever the agent's state changes (a battery
+/// reading, a device coming or going).
+pub async fn watch_devices(mut changes: watch::Receiver<Observation>) {
+    while changes.changed().await.is_ok() {
+        request_refresh();
+    }
+}
+
+/// One line per device: its name and battery (or that it is offline).
+fn device_lines() -> Vec<String> {
+    let Some(observable) = OBSERVABLE.get() else {
+        return Vec::new();
+    };
+    let config = CONFIG
+        .lock()
+        .ok()
+        .and_then(|config| config.clone())
+        .unwrap_or_default();
+    crate::tray_model::TrayMenu::new(&observable.snapshot(), &config)
+        .devices
+        .iter()
+        .map(|row| {
+            use crate::tray_model::DeviceState;
+            match &row.state {
+                DeviceState::Battery(battery) => {
+                    format!("{}: {}", row.name, crate::tray_model::battery_text(battery))
+                }
+                DeviceState::Offline(_) => {
+                    format!("{}: {}", row.name, rust_i18n::t!("tray.offline"))
+                }
+                DeviceState::Light(_) | DeviceState::Online => row.name.clone(),
+            }
+        })
+        .collect()
+}
+
+/// "OpenLogi", then each device on its own line.
+fn tooltip_text() -> String {
+    let mut tip = String::from("OpenLogi");
+    for line in device_lines() {
+        tip.push('\n');
+        tip.push_str(&line);
+    }
+    tip
+}
