     assert_eq!(unchanged.generation, since);
     assert_eq!(started.elapsed(), OBSERVE_HOLD);
 }
+
+fn levels(warn: u8, rearm: u8) -> AppSettings {
+    AppSettings {
+        low_battery_warn_percent: warn,
+        low_battery_rearm_percent: rearm,
+        ..AppSettings::default()
+    }
+}
+
+#[test]
+fn the_users_warning_level_decides_what_is_low() {
+    let settings = levels(50, 70);
+    let mut watch = LowBatteryWatch::default();
+    assert!(!watch.take_reading(&settings, "mouse", &discharging(51)));
+    assert!(
+        watch.take_reading(&settings, "mouse", &discharging(50)),
+        "at the level"
+    );
+    assert!(
+        !watch.take_reading(&settings, "mouse", &discharging(45)),
+        "once per discharge"
+    );
+}
+
+#[test]
+fn the_users_rearm_level_decides_what_is_charged_again() {
+    let settings = levels(50, 70);
+    let mut watch = LowBatteryWatch::default();
+    assert!(watch.take_reading(&settings, "mouse", &discharging(40)));
+    assert!(
+        !watch.take_reading(&settings, "mouse", &discharging(65)),
+        "not yet re-armed"
+    );
+    assert!(!watch.take_reading(&settings, "mouse", &discharging(45)));
+    assert!(
+        !watch.take_reading(&settings, "mouse", &discharging(70)),
+        "re-armed, not low"
+    );
+    assert!(
+        watch.take_reading(&settings, "mouse", &discharging(50)),
+        "the next discharge"
+    );
+}
+
+#[test]
+fn a_rearm_level_under_the_warning_level_is_lifted_above_it() {
+    let settings = levels(40, 10);
+    let mut watch = LowBatteryWatch::default();
+    assert!(watch.take_reading(&settings, "mouse", &discharging(40)));
+    assert!(
+        !watch.take_reading(&settings, "mouse", &discharging(40)),
+        "low is never also recharged"
+    );
+    assert!(
+        !watch.take_reading(&settings, "mouse", &discharging(41)),
+        "41 re-arms"
+    );
+    assert!(watch.take_reading(&settings, "mouse", &discharging(39)));
+}
