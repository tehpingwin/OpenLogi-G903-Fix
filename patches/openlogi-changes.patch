+/// The displays offered by number. Windows numbers them from 1; a number
+/// with no display behind it falls back to the main display.
+const NUMBERED_DISPLAYS: u8 = 4;
+
+fn notice_display_key(display: openlogi_core::config::NoticeDisplay) -> SharedString {
+    use openlogi_core::config::NoticeDisplay;
+    match display {
+        NoticeDisplay::Pointer => "pointer".into(),
+        NoticeDisplay::Primary => "primary".into(),
+        NoticeDisplay::Numbered(number) => format!("display-{number}").into(),
+    }
+}
+
+fn notice_display_from_key(key: &str) -> openlogi_core::config::NoticeDisplay {
+    use openlogi_core::config::NoticeDisplay;
+    match key {
+        "primary" => NoticeDisplay::Primary,
+        _ => key
+            .strip_prefix("display-")
+            .and_then(|number| number.parse().ok())
+            .map_or(NoticeDisplay::Pointer, NoticeDisplay::Numbered),
+    }
+}
+
+/// The display the overlay's notices appear on.
+fn notice_display_item() -> SettingItem {
+    use openlogi_core::config::NoticeDisplay;
+    let mut options: Vec<(SharedString, SharedString)> = vec![
+        (
+            notice_display_key(NoticeDisplay::Pointer),
+            tr!("app.notice_display_pointer"),
+        ),
+        (
+            notice_display_key(NoticeDisplay::Primary),
+            tr!("app.notice_display_primary"),
+        ),
+    ];
+    options.extend((1..=NUMBERED_DISPLAYS).map(|number| {
+        (
+            notice_display_key(NoticeDisplay::Numbered(number)),
+            tr!("app.notice_display_number", number => number),
+        )
+    }));
+    SettingItem::new(
+        tr!("app.notice_display"),
+        SettingField::dropdown(
+            options,
+            |cx| {
+                notice_display_key(
+                    AppState::try_read(cx)
+                        .map_or_else(NoticeDisplay::default, |s| s.app_settings().notice_display),
+                )
+            },
+            |key, cx| {
+                let display = notice_display_from_key(&key);
+                AppState::apply(cx, |state| state.commit_notice_display(display));
+            },
+        ),
+    )
+    .description(tr!("app.notice_display_description"))
+}
