+    #[must_use]
+    pub fn stored_lighting(&self, configured: &Lighting) -> Option<Lighting> {
+        let (active, _) = self.stored_mode()?;
+        let entry = self
+            .current_record()
+            .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))?;
