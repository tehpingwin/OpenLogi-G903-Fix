+    /// Reads a whole sector. The last chunk is read at `sector_size - 16`, so
+    /// a size that isn't a multiple of 16 (a G903's 255) never reads past it.
+    pub async fn read_sector(
+        &self,
+        info: &OnboardProfilesInfo,
+        sector: u16,
+    ) -> Result<Vec<u8>, Hidpp20Error> {
+        let size = info.sector_size;
+        if size < READ_CHUNK {
+            return Err(Hidpp20Error::UnsupportedResponse);
+        }
+        let mut data = vec![0; usize::from(size)];
+        let mut offset = 0;
+        while offset < size {
+            let at = offset.min(size - READ_CHUNK);
+            let chunk = self.read_memory(sector, at).await?;
+            let start = usize::from(at);
+            data[start..start + usize::from(READ_CHUNK)].copy_from_slice(&chunk);
+            offset += READ_CHUNK;
+        }
+        Ok(data)
+    }
+
+    /// Writes `data` to `sector`: start, 16-byte chunks (the last padded with
+    /// `0xff` past `data`), end. The device commits on the end call. This only
+    /// sends the bytes; checking what the device stored is the caller's job.
+    pub async fn write_sector(&self, sector: u16, data: &[u8]) -> Result<(), Hidpp20Error> {
+        let len = u16::try_from(data.len()).map_err(|_| Hidpp20Error::UnsupportedResponse)?;
+        let [sector_hi, sector_lo] = sector.to_be_bytes();
+        let [len_hi, len_lo] = len.to_be_bytes();
+        let mut start = [0; 16];
+        start[..6].copy_from_slice(&[sector_hi, sector_lo, 0, 0, len_hi, len_lo]);
+        self.endpoint.call_long(FN_MEMORY_ADDR_WRITE, start).await?;
+        for chunk in data.chunks(WRITE_CHUNK) {
+            let mut args = [0xff; 16];
+            args[..chunk.len()].copy_from_slice(chunk);
+            self.endpoint.call_long(FN_MEMORY_WRITE, args).await?;
+        }
+        self.endpoint.call(FN_MEMORY_WRITE_END, [0; 3]).await?;
+        Ok(())
+    }
