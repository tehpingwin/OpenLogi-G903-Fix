     );
     assert!(watch.take_reading(&settings, "mouse", &discharging(39)));
 }
+
+#[tokio::test(start_paused = true)]
+async fn a_notice_posted_for_longer_stays_longer() {
+    let board = NoticeBoard::default();
+    board.post_for(low_battery("MX"), None, Duration::from_secs(30));
+    let shown = board.observe(0).await;
+    tokio::time::advance(NOTICE_LIFETIME + Duration::from_secs(1)).await;
+    let later = board.observe(0).await;
+    assert_eq!(
+        later.notices.len(),
+        1,
+        "still on screen after the usual time"
+    );
+    tokio::time::advance(Duration::from_secs(30)).await;
+    let ended = board.observe(shown.generation).await;
+    assert!(ended.notices.is_empty(), "gone once its own time is up");
+}
