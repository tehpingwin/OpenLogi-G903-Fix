diff --git a/crates/openlogi-device/src/write/onboard/edit/convert.rs b/crates/openlogi-device/src/write/onboard/edit/convert.rs
new file mode 100644
index 00000000..87838297
--- /dev/null
+++ b/crates/openlogi-device/src/write/onboard/edit/convert.rs
@@ -0,0 +1,187 @@
+//! Between the `0x8100` codec's types and the wire types in `openlogi-core`.
+
+use hidpp::feature::color_led_effects::Rgb as HidppRgb;
+use hidpp::feature::onboard_profiles::{Binding, LedEffect, MacroStep, StoredProfile};
+use openlogi_core::color::Rgb;
+use openlogi_core::hid::{OnboardMode, ProfileIndex, stored_profile as wire};
+
+use super::StoredProfiles;
+use hidpp::feature::onboard_profiles;
+
+fn rgb_to_wire(c: HidppRgb) -> Rgb {
+    Rgb::new(c.red, c.green, c.blue)
+}
+
+fn rgb_from_wire(c: Rgb) -> HidppRgb {
+    let (red, green, blue) = c.components();
+    HidppRgb { red, green, blue }
+}
+
+pub(super) fn binding_to_wire(b: Binding) -> wire::StoredBinding {
+    match b {
+        Binding::MouseButton(n) => wire::StoredBinding::MouseButton(n),
+        Binding::Key { modifiers, usage } => wire::StoredBinding::Key { modifiers, usage },
+        Binding::Consumer(u) => wire::StoredBinding::Consumer(u),
+        Binding::Special { function, profile } => {
+            wire::StoredBinding::Special { function, profile }
+        }
+        Binding::StoredMacro { sector, offset } => {
+            wire::StoredBinding::StoredMacro { sector, offset }
+        }
+        Binding::Disabled => wire::StoredBinding::Disabled,
+        Binding::Other(raw) => wire::StoredBinding::Other(raw),
+    }
+}
+
+pub(super) fn binding_from_wire(b: wire::StoredBinding) -> Binding {
+    match b {
+        wire::StoredBinding::MouseButton(n) => Binding::MouseButton(n),
+        wire::StoredBinding::Key { modifiers, usage } => Binding::Key { modifiers, usage },
+        wire::StoredBinding::Consumer(u) => Binding::Consumer(u),
+        wire::StoredBinding::Special { function, profile } => {
+            Binding::Special { function, profile }
+        }
+        wire::StoredBinding::StoredMacro { sector, offset } => {
+            Binding::StoredMacro { sector, offset }
+        }
+        wire::StoredBinding::Disabled => Binding::Disabled,
+        wire::StoredBinding::Other(raw) => Binding::Other(raw),
+    }
+}
+
+fn led_to_wire(l: LedEffect) -> wire::StoredLed {
+    match l {
+        LedEffect::Off => wire::StoredLed::Off,
+        LedEffect::Fixed(c) => wire::StoredLed::Fixed(rgb_to_wire(c)),
+        LedEffect::Breathing {
+            color,
+            period_ms,
+            brightness,
+        } => wire::StoredLed::Breathing {
+            color: rgb_to_wire(color),
+            period_ms,
+            brightness,
+        },
+        LedEffect::Cycle {
+            period_ms,
+            brightness,
+        } => wire::StoredLed::Cycle {
+            period_ms,
+            brightness,
+        },
+        LedEffect::Other(raw) => wire::StoredLed::Other(raw),
+    }
+}
+
+fn led_from_wire(l: wire::StoredLed) -> LedEffect {
+    match l {
+        wire::StoredLed::Off => LedEffect::Off,
+        wire::StoredLed::Fixed(c) => LedEffect::Fixed(rgb_from_wire(c)),
+        wire::StoredLed::Breathing {
+            color,
+            period_ms,
+            brightness,
+        } => LedEffect::Breathing {
+            color: rgb_from_wire(color),
+            period_ms,
+            brightness,
+        },
+        wire::StoredLed::Cycle {
+            period_ms,
+            brightness,
+        } => LedEffect::Cycle {
+            period_ms,
+            brightness,
+        },
+        wire::StoredLed::Other(raw) => LedEffect::Other(raw),
+    }
+}
+
+pub(super) fn settings_to_wire(p: &StoredProfile) -> wire::StoredProfileSettings {
+    wire::StoredProfileSettings {
+        report_interval_ms: p.report_interval_ms,
+        default_dpi_level: p.default_dpi_level,
+        shift_dpi_level: p.shift_dpi_level,
+        dpi: p.dpi,
+        leds: p.leds.map(led_to_wire),
+        power_save_leds: p.power_save_leds.map(led_to_wire),
+        buttons: p.buttons.iter().copied().map(binding_to_wire).collect(),
+        shift_buttons: p
+            .shift_buttons
+            .iter()
+            .copied()
+            .map(binding_to_wire)
+            .collect(),
+    }
+}
+
+/// The edited `settings` laid over `base`, the profile decoded from the
+/// mouse. Button lists keep `base`'s length whatever the caller sent, and the
+/// power-saving copy always comes from `base`: the codec derives it from a
+/// changed light itself.
+pub(super) fn settings_from_wire(
+    settings: &wire::StoredProfileSettings,
+    base: &StoredProfile,
+) -> StoredProfile {
+    let layer = |edited: &[wire::StoredBinding], base: &[Binding]| -> Vec<Binding> {
+        base.iter()
+            .enumerate()
+            .map(|(i, &b)| edited.get(i).map_or(b, |&e| binding_from_wire(e)))
+            .collect()
+    };
+    StoredProfile {
+        report_interval_ms: settings.report_interval_ms,
+        default_dpi_level: settings.default_dpi_level,
+        shift_dpi_level: settings.shift_dpi_level,
+        dpi: settings.dpi,
+        leds: settings.leds.map(led_from_wire),
+        power_save_leds: base.power_save_leds,
+        buttons: layer(&settings.buttons, &base.buttons),
+        shift_buttons: layer(&settings.shift_buttons, &base.shift_buttons),
+    }
+}
+
+fn step_to_wire(s: MacroStep) -> wire::StoredMacroStep {
+    match s {
+        MacroStep::KeyDown(m, u) => wire::StoredMacroStep::KeyDown(m, u),
+        MacroStep::KeyUp(m, u) => wire::StoredMacroStep::KeyUp(m, u),
+        MacroStep::Delay(ms) => wire::StoredMacroStep::Delay(ms),
+    }
+}
+
+pub(super) fn profiles_to_wire(p: StoredProfiles) -> wire::StoredProfiles {
+    wire::StoredProfiles {
+        mode: match p.mode {
+            onboard_profiles::OnboardMode::Onboard => OnboardMode::Onboard,
+            onboard_profiles::OnboardMode::Host => OnboardMode::Host,
+        },
+        active: p.active.map(ProfileIndex::from),
+        dpi_values: p.dpi_values,
+        profiles: p
+            .profiles
+            .into_iter()
+            .map(|slot| wire::StoredProfileSlot {
+                index: ProfileIndex::from(slot.index),
+                enabled: slot.enabled,
+                settings: slot
+                    .decoded
+                    .as_ref()
+                    .map(settings_to_wire)
+                    .map_err(ToString::to_string),
+                base: slot.raw,
+            })
+            .collect(),
+        factory_buttons: p.factory_buttons.into_iter().map(binding_to_wire).collect(),
+        macros: p
+            .macros
+            .into_iter()
+            .map(|((sector, offset), steps)| wire::StoredMacro {
+                sector,
+                offset,
+                steps: steps
+                    .map(|steps| steps.into_iter().map(step_to_wire).collect())
+                    .map_err(|e| e.to_string()),
+            })
+            .collect(),
+    }
+}
