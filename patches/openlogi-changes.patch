+/// The user's warning and re-arm levels, the re-arm kept above the warning
+/// so a reading can't be both low and recharged.
+#[derive(Debug, Clone, Copy)]
+struct Levels {
+    warn: u8,
+    rearm: u8,
+}
+
+impl Levels {
+    fn of(settings: &AppSettings) -> Self {
+        let warn = settings.low_battery_warn_percent.min(99);
+        Self {
+            warn,
+            rearm: settings.low_battery_rearm_percent.max(warn + 1),
+        }
+    }
