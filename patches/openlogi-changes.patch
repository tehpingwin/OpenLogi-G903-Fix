+fn dimmed(color: Rgb, brightness: u8) -> Rgb {
+    let (r, g, b) = color.components();
+    let scale =
+        |v: u8| u8::try_from(u16::from(v) * u16::from(brightness.min(100)) / 100).unwrap_or(v);
