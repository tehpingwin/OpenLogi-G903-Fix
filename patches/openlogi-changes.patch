+use std::num::NonZeroU8;
+
+use super::*;
+
+include!("fixtures.rs");
+
+const RANGE: (u16, u16) = (100, 25_600);
+const FORMAT: u8 = 4;
+const BUTTONS_N: u8 = 12;
+
+fn decode(sector: &[u8]) -> StoredProfile {
+    StoredProfile::decode(sector, FORMAT, BUTTONS_N, RANGE).unwrap()
+}
+
+fn changed(a: &[u8], b: &[u8]) -> Vec<usize> {
+    a.iter()
+        .zip(b)
+        .enumerate()
+        .filter(|(_, (x, y))| x != y)
+        .map(|(i, _)| i)
+        .collect()
+}
+
+const fn rgb(red: u8, green: u8, blue: u8) -> Rgb {
+    Rgb { red, green, blue }
+}
+
+#[test]
+fn fixtures_have_the_documented_checksums() {
+    assert!(sector_checksum_ok(&DIRECTORY));
+    assert!(sector_checksum_ok(&FACTORY));
+    assert!(sector_checksum_ok(&EDITED));
+    assert_eq!(crc16(&FACTORY[..253]), 0x4569);
+}
+
+#[test]
+fn decodes_the_factory_profile() {
+    let p = decode(&FACTORY);
+    assert_eq!(p.report_interval_ms, 1);
+    assert_eq!(p.default_dpi_level, 1);
+    assert_eq!(p.shift_dpi_level, Some(0)); // stored 00: level 1 (ff would be none)
+    assert_eq!(p.dpi, [400, 800, 1600, 3200, 6400]);
+    assert_eq!(
+        p.leds[0],
+        LedEffect::Cycle {
+            period_ms: 8000,
+            brightness: 100
+        }
+    );
+    assert_eq!(
+        p.power_save_leds[0],
+        LedEffect::Cycle {
+            period_ms: 8000,
+            brightness: 50
+        }
+    );
+    assert_eq!(p.buttons.len(), 12);
+    assert_eq!(&p.buttons[..5], &[1, 2, 3, 4, 5].map(Binding::MouseButton));
+    assert_eq!(
+        p.buttons[7],
+        Binding::Special {
+            function: 0x04,
+            profile: 0
+        }
+    ); // DPI down
+    assert_eq!(
+        p.buttons[9],
+        Binding::Special {
+            function: 0x01,
+            profile: 0xff
+        }
+    ); // tilt left
+    assert!(p.shift_buttons.iter().all(|b| *b == Binding::Disabled));
+}
+
+#[test]
+fn decodes_a_g_hub_edited_profile() {
+    let p = decode(&EDITED);
+    assert_eq!(p.report_interval_ms, 8);
+    assert_eq!(p.dpi, [1800, 0, 0, 0, 0]);
+    assert_eq!(p.shift_dpi_level, Some(0));
+    assert_eq!(p.leds, [LedEffect::Off; 2]);
+    assert_eq!(p.buttons[3], Binding::MouseButton(5));
+    assert_eq!(
+        p.buttons[5],
+        Binding::StoredMacro {
+            sector: 6,
+            offset: 0x00
+        }
+    );
+    assert_eq!(
+        p.buttons[9],
+        Binding::Key {
+            modifiers: 0,
+            usage: 0x28
+        }
+    );
+    assert_eq!(
+        p.shift_buttons[5],
+        Binding::StoredMacro {
+            sector: 6,
+            offset: 0x70
+        }
+    );
+}
+
+#[test]
+fn every_binding_round_trips() {
+    for p in [decode(&FACTORY), decode(&EDITED)] {
+        for b in p.buttons.iter().chain(&p.shift_buttons) {
+            assert_eq!(Binding::decode(b.encode()), *b);
+        }
+    }
+}
+
+#[test]
+fn an_unchanged_profile_encodes_to_the_same_bytes() {
+    for sector in [&FACTORY[..], &EDITED[..]] {
+        let p = decode(sector);
+        assert_eq!(p.encode_onto(sector, &p).unwrap(), sector);
+    }
+}
+
+#[test]
+fn changing_one_button_changes_only_its_bytes() {
+    let before = decode(&EDITED);
+    let mut after = before.clone();
+    after.buttons[9] = Binding::Consumer(0xcd); // Enter -> play/pause
+    let out = after.encode_onto(&EDITED, &before).unwrap();
+    assert_eq!(
+        changed(&EDITED, &out),
+        [0x20 + 36 + 1, 0x20 + 36 + 3, 253, 254]
+    );
+    assert!(sector_checksum_ok(&out));
+    assert_eq!(decode(&out), after);
+}
+
+#[test]
+fn dpi_and_report_rate_touch_only_their_bytes() {
+    let before = decode(&EDITED);
+    let mut after = before.clone();
+    after.dpi[1] = 3200;
+    after.report_interval_ms = 1;
+    let out = after.encode_onto(&EDITED, &before).unwrap();
+    assert_eq!(changed(&EDITED, &out), [0, 5, 6, 253, 254]);
+    assert_eq!(&out[5..7], &[0x80, 0x0c]); // little-endian
+}
+
+#[test]
+fn a_new_light_keeps_a_dimmed_power_saving_copy() {
+    let before = decode(&EDITED); // both lights off: ratio unknown, half is used
+    let mut after = before.clone();
+    after.leds[1] = LedEffect::Breathing {
+        color: rgb(255, 120, 0),
+        period_ms: 4000,
+        brightness: 100,
+    };
+    let out = after.encode_onto(&EDITED, &before).unwrap();
+    let p = decode(&out);
+    assert_eq!(p.leds[1], after.leds[1]);
+    assert_eq!(
+        p.power_save_leds[1],
+        LedEffect::Breathing {
+            color: rgb(255, 120, 0),
+            period_ms: 4000,
+            brightness: 50
+        }
+    );
+    assert_eq!(p.leds[0], LedEffect::Off);
+
+    let before = decode(&FACTORY); // 100 % shown, 50 % saving: the ratio is kept
+    let mut after = before.clone();
+    after.leds[0] = LedEffect::Cycle {
+        period_ms: 8000,
+        brightness: 80,
+    };
+    let p = decode(&after.encode_onto(&FACTORY, &before).unwrap());
+    assert_eq!(
+        p.power_save_leds[0],
+        LedEffect::Cycle {
+            period_ms: 8000,
+            brightness: 40
+        }
+    );
+
+    let mut fixed = before.clone(); // a fixed colour has no brightness byte: its channels dim
+    fixed.leds[0] = LedEffect::Fixed(rgb(200, 100, 0));
+    let p = decode(&fixed.encode_onto(&FACTORY, &before).unwrap());
+    assert_eq!(p.power_save_leds[0], LedEffect::Fixed(rgb(100, 50, 0)));
+}
+
+#[test]
+fn unknown_bytes_survive_every_edit() {
+    let before = decode(&EDITED);
+    let mut after = before.clone();
+    after.buttons[0] = Binding::MouseButton(1);
+    after.buttons[10] = Binding::Key {
+        modifiers: 0x01,
+        usage: 0x06,
+    };
+    after.dpi[0] = 1850;
+    after.leds[0] = LedEffect::Fixed(rgb(0, 255, 0));
+    let out = after.encode_onto(&EDITED, &before).unwrap();
+    for range in [13..32, 0xa0..0xd0] {
+        // colour, power mode, angle snapping, timeouts, name
+        assert_eq!(&out[range.clone()], &EDITED[range]);
+    }
+}
+
+#[test]
+fn refuses_what_it_does_not_understand() {
+    assert_eq!(
+        StoredProfile::decode(&FACTORY, 9, 12, RANGE),
+        Err(ProfileError::UnsupportedFormat(9))
+    );
+    assert_eq!(
+        StoredProfile::decode(&FACTORY[..200], 4, 12, RANGE),
+        Err(ProfileError::TooShort)
+    );
+    let mut damaged = FACTORY;
+    damaged[40] ^= 0xff;
+    assert_eq!(
+        StoredProfile::decode(&damaged, 4, 12, RANGE),
+        Err(ProfileError::Checksum)
+    );
+    let mut odd_rate = FACTORY;
+    odd_rate[0] = 3;
+    seal_sector(&mut odd_rate);
+    assert!(matches!(
+        StoredProfile::decode(&odd_rate, 4, 12, RANGE),
+        Err(ProfileError::Implausible(_))
+    ));
+}
+
+#[test]
+fn validation_keeps_the_mouse_usable() {
+    let p = decode(&EDITED);
+    assert_eq!(p.validate(RANGE, 50), Ok(()));
+    let mut no_left = p.clone();
+    no_left.buttons[0] = Binding::MouseButton(4);
+    assert_eq!(
+        no_left.validate(RANGE, 50),
+        Err(ProfileError::Implausible("no button is left click"))
+    );
+    no_left.buttons[11] = Binding::MouseButton(1); // another button takes over
+    assert_eq!(no_left.validate(RANGE, 50), Ok(()));
+    let mut off_step = p.clone();
+    off_step.dpi[0] = 1825;
+    assert!(
+        off_step.validate(RANGE, 50).is_err(),
+        "1825 is not a multiple of 50 from 100"
+    );
+    let mut no_levels = p.clone();
+    no_levels.dpi = [0; 5];
+    assert!(
+        no_levels.validate(RANGE, 50).is_err(),
+        "a profile needs a DPI level"
+    );
+}
+
+#[test]
+fn switching_a_profile_on_changes_one_flag() {
+    let out = directory_with_enabled(&DIRECTORY, NonZeroU8::new(2).unwrap(), 2).unwrap();
+    assert_eq!(changed(&DIRECTORY, &out), [6, 253, 254]);
+    assert_eq!(out[6], 0x01);
+    assert_eq!(out[7], 0xff, "G HUB's fourth byte is kept");
+    assert!(
+        directory_with_enabled(&DIRECTORY, NonZeroU8::new(2).unwrap(), 9).is_err(),
+        "wrong sector"
+    );
+}
+
+#[test]
+fn reads_the_stored_macros() {
+    let read = |sector: u8| (sector == 6).then(|| MACROS.to_vec());
+    let chords = |offset: usize| -> Vec<(bool, u8)> {
+        read_stored_macro(6, offset, read)
+            .unwrap()
+            .into_iter()
+            .filter_map(|s| match s {
+                MacroStep::KeyDown(_, u) => Some((true, u)),
+                MacroStep::KeyUp(_, u) => Some((false, u)),
+                MacroStep::Delay(_) => None,
+            })
+            .collect()
+    };
+    // Ctrl+Tab, Ctrl+Shift+Tab, Ctrl+Shift+T, Ctrl+W
+    assert_eq!(
+        chords(0x00),
+        [(true, 0xe0), (true, 0x2b), (false, 0xe0), (false, 0x2b)]
+    );
+    assert_eq!(
+        chords(0x16),
+        [
+            (true, 0xe0),
+            (true, 0xe1),
+            (true, 0x2b),
+            (false, 0x2b),
+            (false, 0xe0),
+            (false, 0xe1)
+        ]
+    );
+    assert_eq!(
+        chords(0x38),
+        [
+            (true, 0xe0),
+            (true, 0xe1),
+            (true, 0x17),
+            (false, 0xe0),
+            (false, 0x17),
+            (false, 0xe1)
+        ]
+    );
+    assert_eq!(
+        chords(0x5a),
+        [(true, 0xe0), (true, 0x1a), (false, 0xe0), (false, 0x1a)]
+    );
+    assert_eq!(
+        read_stored_macro(6, 0x00, |_| None),
+        Err(MacroError::Unreadable)
+    );
+}
