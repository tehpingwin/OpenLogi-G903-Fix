+//! "Stored in the mouse": the stored profile's own button bindings, edited
+//! and saved into the mouse, so they work without OpenLogi running. Shown
+//! under the binding inspector while a stored profile is in control.
+
+use gpui::{
+    App, Context, IntoElement, ParentElement, Role, SharedString, Styled, div,
+    prelude::FluentBuilder as _,
+};
+use gpui_kit::component::{Disableable as _, Selectable as _, h_flex, v_flex};
+use openlogi_core::config::OnboardMemory;
+use openlogi_core::hid::{ProfileIndex, StoredBinding, StoredMacroStep, StoredProfiles};
+
+use super::view::MouseModelView;
+use crate::state::{AppState, Load, StoredProfileNotice};
+use crate::ui::components::{MenuRow, ProfileTab, control_button};
+use crate::ui::section::section_label;
+use crate::ui::theme::{self, Typography as _};
+
+const MOUSE: [(u8, &str); 5] = [
+    (1, "actions.left_click"),
+    (2, "actions.right_click"),
+    (3, "actions.middle_click"),
+    (4, "actions.back"),
+    (5, "actions.forward"),
+];
+const MEDIA: [(u16, &str); 6] = [
+    (0xcd, "actions.play_pause"),
+    (0xb5, "actions.next_track"),
+    (0xb6, "actions.previous_track"),
+    (0xe9, "actions.volume_up"),
+    (0xea, "actions.volume_down"),
+    (0xe2, "actions.mute"),
+];
+const FUNCTIONS: [(u8, &str); 11] = [
+    (0x03, "pointer.next_dpi_preset"),
+    (0x04, "pointer.previous_dpi_preset"),
+    (0x05, "pointer.cycle_dpi_presets"),
+    (0x07, "pointer.dpi_shift"),
+    (0x08, "stored_profile.next_profile"),
+    (0x09, "stored_profile.previous_profile"),
+    (0x0a, "stored_profile.cycle_profiles"),
+    (0x0b, "actions.g_shift_hold"),
+    (0x0c, "stored_profile.battery_level"),
+    (0x01, "actions.scroll_left"),
+    (0x02, "actions.scroll_right"),
+];
+
+/// A key name for a HID usage (page 7). Key names stay in English, as on
+/// the keycaps.
+fn key_name(usage: u8) -> String {
+    match usage {
+        0x04..=0x1d => char::from(b'A' + (usage - 0x04)).to_string(),
+        0x1e..=0x26 => char::from(b'1' + (usage - 0x1e)).to_string(),
+        0x27 => "0".into(),
+        0x3a..=0x45 => format!("F{}", usage - 0x3a + 1),
+        0x68..=0x73 => format!("F{}", usage - 0x68 + 13),
+        0x28 => "Enter".into(),
+        0x29 => "Esc".into(),
+        0x2a => "Backspace".into(),
+        0x2b => "Tab".into(),
+        0x2c => "Space".into(),
+        0x46 => "Print Screen".into(),
+        0x49 => "Insert".into(),
+        0x4a => "Home".into(),
+        0x4b => "Page Up".into(),
+        0x4c => "Delete".into(),
+        0x4d => "End".into(),
+        0x4e => "Page Down".into(),
+        0x4f => "Right".into(),
+        0x50 => "Left".into(),
+        0x51 => "Down".into(),
+        0x52 => "Up".into(),
+        0xe0 | 0xe4 => "Ctrl".into(),
+        0xe1 | 0xe5 => "Shift".into(),
+        0xe2 | 0xe6 => "Alt".into(),
+        0xe3 | 0xe7 => "Win".into(),
+        other => format!("Key {other:02X}"),
+    }
+}
+
+fn key_combo(modifiers: u8, usage: u8) -> String {
+    let mut parts = Vec::new();
+    for (bits, name) in [
+        (0x11, "Ctrl"),
+        (0x22, "Shift"),
+        (0x44, "Alt"),
+        (0x88, "Win"),
+    ] {
+        if modifiers & bits != 0 {
+            parts.push(name.to_owned());
+        }
+    }
+    parts.push(key_name(usage));
+    parts.join(" + ")
+}
+
+/// "Ctrl + Tab" for a stored macro: the keys held when the first one of a
+/// chord is released, chord by chord.
+fn macro_keys(steps: &[StoredMacroStep]) -> String {
+    let mut held: Vec<u8> = Vec::new();
+    let mut chords: Vec<String> = Vec::new();
+    let mut emitted = false;
+    for step in steps {
+        match *step {
+            StoredMacroStep::KeyDown(_, usage) => {
+                held.push(usage);
+                emitted = false;
+            }
+            StoredMacroStep::KeyUp(_, usage) => {
+                if !emitted && !held.is_empty() {
+                    chords.push(
+                        held.iter()
+                            .map(|&u| key_name(u))
+                            .collect::<Vec<_>>()
+                            .join(" + "),
+                    );
+                    emitted = true;
+                }
+                held.retain(|&u| u != usage);
+            }
+            StoredMacroStep::Delay(_) => {}
+        }
+    }
+    chords.join(", ")
+}
+
+fn binding_label(binding: StoredBinding, profiles: &StoredProfiles) -> SharedString {
+    match binding {
+        StoredBinding::MouseButton(n) => MOUSE.iter().find(|(v, _)| *v == n).map_or_else(
+            || tr!("stored_profile.mouse_button", number = n),
+            |(_, key)| tr!(*key),
+        ),
+        StoredBinding::Key { modifiers, usage } => key_combo(modifiers, usage).into(),
+        StoredBinding::Consumer(code) => MEDIA.iter().find(|(v, _)| *v == code).map_or_else(
+            || tr!("stored_profile.media_key", code = format!("{code:04X}")),
+            |(_, key)| tr!(*key),
+        ),
+        StoredBinding::Special { function, .. } => {
+            FUNCTIONS.iter().find(|(v, _)| *v == function).map_or_else(
+                || tr!("stored_profile.function", number = function),
+                |(_, key)| tr!(*key),
+            )
+        }
+        StoredBinding::StoredMacro { sector, offset } => {
+            match profiles
+                .stored_macro(sector, offset)
+                .and_then(|m| m.steps.as_ref().ok())
+            {
+                Some(steps) if !steps.is_empty() => {
+                    tr!("stored_profile.macro", keys = macro_keys(steps))
+                }
+                _ => tr!("stored_profile.macro_stored"),
+            }
+        }
+        StoredBinding::Disabled => tr!("pointer.do_nothing"),
+        StoredBinding::Other(_) => tr!("stored_profile.other"),
+    }
+}
+
+fn notice_text(notice: &StoredProfileNotice) -> SharedString {
+    match notice {
+        StoredProfileNotice::Saved => tr!("stored_profile.saved"),
+        StoredProfileNotice::NothingToSave => tr!("stored_profile.nothing_to_save"),
+        StoredProfileNotice::Selected(index) => {
+            tr!("stored_profile.selected", number = index.get())
+        }
+        StoredProfileNotice::Failed(error) => {
+            tr!("stored_profile.failed", error = error.to_string())
+        }
+    }
+}
+
+/// One choice row: selected when it is what the button does now.
+fn choice(
+    id: (&'static str, usize),
+    label: SharedString,
+    selected: bool,
+    enabled: bool,
+    shown: ProfileIndex,
+    button: usize,
+    binding: StoredBinding,
+) -> impl IntoElement {
+    MenuRow::new(id)
+        .selected(selected)
+        .role(Role::Button)
+        .child(div().text_body().child(label))
+        .when(enabled, |row| {
+            row.on_click(move |_, _, cx: &mut App| {
+                AppState::apply(cx, |state| {
+                    state.edit_stored_profile(shown, |settings| {
+                        if let Some(slot) = settings.buttons.get_mut(button) {
+                            *slot = binding;
+                        }
+                    })
+                });
+            })
+        })
+}
+
+/// The panel, or `None` when the selected device has no stored profiles or
+/// OpenLogi is in control.
+pub(super) fn stored_profile_panel(cx: &Context<MouseModelView>) -> Option<gpui::Div> {
+    let state = AppState::try_read(cx)?;
+    if !state.current_onboard_supported()
+        || state.current_onboard_active() == Some(OnboardMemory::Off)
+    {
+        return None;
+    }
+    let pal = theme::palette(cx);
+    let header = v_flex()
+        .gap_1()
+        .child(section_label(tr!("stored_profile.title"), pal))
+        .child(
+            div()
+                .text_caption()
+                .text_color(pal.text_muted)
+                .child(tr!("stored_profile.description")),
+        );
+
+    let profiles = match state.current_stored_profiles() {
+        Load::Ready(profiles) => profiles,
+        Load::Unsupported(_) => return None,
+        Load::Failed(error) => {
+            return Some(
+                v_flex()
+                    .gap_2()
+                    .child(header)
+                    .child(
+                        div()
+                            .text_body()
+                            .child(tr!("stored_profile.read_failed", error = error)),
+                    )
+                    .child(
+                        control_button("stored-retry")
+                            .label(tr!("stored_profile.retry"))
+                            .on_click(|_, _, cx| {
+                                AppState::update(cx, |state, cx| state.read_stored_profiles(cx))
+                            }),
+                    ),
+            );
+        }
+        Load::Unknown | Load::Loading => {
+            return Some(
+                v_flex().gap_2().child(header).child(
+                    div()
+                        .text_body()
+                        .text_color(pal.text_muted)
+                        .child(tr!("stored_profile.reading")),
+                ),
+            );
+        }
+    };
+
+    let shown = state.current_stored_profile_shown()?;
+    let busy = state.current_stored_profile_busy();
+    let edit = state
+        .current_stored_profile_edit()
+        .filter(|edit| edit.index == shown);
+    let dirty = edit.is_some_and(|edit| edit.is_dirty());
+    let slot = profiles.profiles.iter().find(|slot| slot.index == shown)?;
+
+    let tabs = h_flex()
+        .gap_1()
+        .children(profiles.profiles.iter().map(|slot| {
+            let index = slot.index;
+            ProfileTab::new(
+                ("stored-profile", usize::from(index.get().get())),
+                format!("{index}"),
+            )
+            .selected(index == shown)
+            .on_click(move |_, _, cx| AppState::apply(cx, |state| state.show_stored_profile(index)))
+        }));
+    let in_use = if profiles.active == Some(shown) {
+        div()
+            .text_caption()
+            .text_color(pal.text_muted)
+            .child(tr!("stored_profile.in_use"))
+    } else {
+        let label = if slot.enabled {
+            tr!("stored_profile.use_profile")
+        } else {
+            tr!("stored_profile.use_profile_off")
+        };
+        div().child(
+            control_button("stored-use-profile")
+                .label(label)
+                .disabled(busy || dirty)
+                .on_click(move |_, _, cx| {
+                    AppState::apply(cx, |state| state.select_stored_profile(shown))
+                }),
+        )
+    };
+
+    let mut panel = v_flex().gap_2().child(header).child(tabs).child(in_use);
+
+    let settings = match (&edit, &slot.settings) {
+        (Some(edit), _) => &edit.settings,
+        (None, Ok(settings)) => settings,
+        (None, Err(reason)) => {
+            return Some(
+                panel.child(
+                    div()
+                        .text_body()
+                        .child(tr!("stored_profile.not_editable", reason = reason.clone())),
+                ),
+            );
+        }
+    };
+
+    let open = state.current_stored_open_button();
+    for (index, &binding) in settings.buttons.iter().enumerate() {
+        let original = profiles
+            .factory_buttons
+            .get(index)
+            .map(|&b| binding_label(b, &profiles));
+        let row = MenuRow::new(("stored-button", index))
+            .selected(open == Some(index))
+            .role(Role::Button)
+            .child(
+                v_flex()
+                    .min_w_0()
+                    .child(
+                        h_flex()
+                            .justify_between()
+                            .gap_2()
+                            .child(
+                                div()
+                                    .text_body()
+                                    .child(tr!("stored_profile.button", number = index + 1)),
+                            )
+                            .child(div().text_body().child(binding_label(binding, &profiles))),
+                    )
+                    .when_some(original, |row, original| {
+                        row.child(
+                            div()
+                                .text_caption()
+                                .text_color(pal.text_muted)
+                                .child(tr!("stored_profile.originally", action = original)),
+                        )
+                    }),
+            )
+            .on_click(move |_, _, cx| {
+                AppState::apply(cx, |state| state.open_stored_button(Some(index)))
+            });
+        panel = panel.child(row);
+        if open == Some(index) {
+            let enabled = !busy;
+            let mut choices = v_flex().gap_1().pl_3();
+            choices = choices.child(section_label(tr!("stored_profile.group_mouse"), pal));
+            for (i, (n, key)) in MOUSE.iter().enumerate() {
+                let b = StoredBinding::MouseButton(*n);
+                choices = choices.child(choice(
+                    ("stored-choice-mouse", i),
+                    tr!(*key),
+                    binding == b,
+                    enabled,
+                    shown,
+                    index,
+                    b,
+                ));
+            }
+            choices = choices.child(section_label(tr!("stored_profile.group_media"), pal));
+            for (i, (code, key)) in MEDIA.iter().enumerate() {
+                let b = StoredBinding::Consumer(*code);
+                choices = choices.child(choice(
+                    ("stored-choice-media", i),
+                    tr!(*key),
+                    binding == b,
+                    enabled,
+                    shown,
+                    index,
+                    b,
+                ));
+            }
+            choices = choices.child(section_label(tr!("stored_profile.group_functions"), pal));
+            for (i, (function, key)) in FUNCTIONS.iter().enumerate() {
+                let b = StoredBinding::Special {
+                    function: *function,
+                    profile: 0,
+                };
+                let selected =
+                    matches!(binding, StoredBinding::Special { function: f, .. } if f == *function);
+                choices = choices.child(choice(
+                    ("stored-choice-function", i),
+                    tr!(*key),
+                    selected,
+                    enabled,
+                    shown,
+                    index,
+                    b,
+                ));
+            }
+            choices = choices.child(choice(
+                ("stored-choice-off", 0),
+                tr!("pointer.do_nothing"),
+                binding == StoredBinding::Disabled,
+                enabled,
+                shown,
+                index,
+                StoredBinding::Disabled,
+            ));
+            panel = panel.child(choices);
+        }
+    }
+
+    let footer = h_flex()
+        .gap_2()
+        .child(
+            control_button("stored-save")
+                .label(tr!("stored_profile.save"))
+                .disabled(!dirty || busy)
+                .on_click(|_, _, cx| AppState::apply(cx, |state| state.save_stored_profile_edit())),
+        )
+        .child(
+            control_button("stored-undo")
+                .label(tr!("common.undo"))
+                .disabled(!dirty || busy)
+                .on_click(|_, _, cx| {
+                    AppState::apply(cx, |state| state.discard_stored_profile_edit())
+                }),
+        )
+        .when(dirty, |row| {
+            row.child(
+                div()
+                    .text_caption()
+                    .text_color(pal.text_muted)
+                    .child(tr!("stored_profile.unsaved")),
+            )
+        });
+    panel = panel.child(footer);
+    if let Some(notice) = state.current_stored_profile_notice() {
+        panel = panel.child(div().text_body().child(notice_text(notice)));
+    }
+    Some(panel)
+}
