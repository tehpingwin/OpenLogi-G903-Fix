+//! Editing stored profiles: reading them whole, and the guarded write.
+//!
+//! Every write goes through [`guarded_write`]: re-read the sector until two
+//! reads agree, require it to still equal what the edit was based on and to
+//! carry a valid checksum, hand the original to the caller's backup, write,
+//! read back and compare byte for byte, and on any mismatch write the original
+//! back and check that too. Nothing is written when a step before the write
+//! fails.
+
+use std::collections::BTreeMap;
+use std::num::NonZeroU8;
+use std::sync::Arc;
+
+use hidpp::{
+    channel::HidppChannel,
+    device::Device,
+    feature::onboard_profiles::{
+        self, Binding, MacroError, MacroStep, OnboardProfilesFeature, OnboardProfilesInfo,
+        ProfileError, StoredProfile, directory_with_enabled, factory_bindings, read_stored_macro,
+        sector_checksum_ok,
+    },
+};
+use tracing::{debug, warn};
+
+use crate::SharedChannel;
+
+use super::super::dpi::get_dpi_info_on_channel;
+use super::super::{HidppOperation, WriteError, classify_hidpp_error, open_feature};
+
+const FEATURE: u16 = 0x8100;
+const USER_DIRECTORY: u16 = 0x0000;
+const FIRST_ROM_SECTOR: u16 = 0x0100;
+const FACTORY_PROFILE: u16 = 0x0101;
+const STABLE_READ_ATTEMPTS: usize = 3;
+
+/// Saves a copy of `sector` before it is overwritten; `false` stops the write.
+pub type Backup<'a> = &'a (dyn Fn(u16, &[u8]) -> bool + Send + Sync);
+
+/// One profile slot as read, with the bytes every edit is based on.
+#[derive(Clone, Debug)]
+pub struct StoredProfileSlot {
+    /// 1-based index.
+    pub index: NonZeroU8,
+    /// Flash sector.
+    pub sector: u16,
+    /// Whether it is on in the profile list (the mouse only selects those).
+    pub enabled: bool,
+    /// The sector as read.
+    pub raw: Vec<u8>,
+    /// The decoded profile, or why it can't be edited.
+    pub decoded: Result<StoredProfile, ProfileError>,
+}
+
+/// Everything the profile editor shows.
+#[derive(Clone, Debug)]
+pub struct StoredProfiles {
+    /// The `0x8100` description.
+    pub info: OnboardProfilesInfo,
+    /// Who is in control now.
+    pub mode: onboard_profiles::OnboardMode,
+    /// The active profile, `None` in host mode.
+    pub active: Option<NonZeroU8>,
+    /// The DPI values the sensor accepts, when they could be read.
+    pub dpi_values: Option<Vec<u16>>,
+    /// The user profile slots; empty when the mouse runs its factory profiles.
+    pub profiles: Vec<StoredProfileSlot>,
+    /// What each button did in the factory profile.
+    pub factory_buttons: Vec<Binding>,
+    /// The macros the profiles point to, by `(sector, offset)`.
+    pub macros: BTreeMap<(u8, u8), Result<Vec<MacroStep>, MacroError>>,
+}
+
+/// What a save did.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SaveOutcome {
+    /// The mouse holds the new bytes, checked by reading them back.
+    Saved,
+    /// The edit changed nothing, so nothing was written.
+    Unchanged,
+}
+
+/// Reads every user profile, the factory buttons and the stored macros.
+pub async fn read_stored_profiles_on(shared: &SharedChannel) -> Result<StoredProfiles, WriteError> {
+    read_stored_profiles_on_channel(shared.channel(), shared.device_index()).await
+}
+
+/// Saves `after` into profile `index`, whose sector read as `original` and
+/// decoded as `before`.
+pub async fn save_stored_profile_on(
+    shared: &SharedChannel,
+    index: NonZeroU8,
+    original: &[u8],
+    before: &StoredProfile,
+    after: &StoredProfile,
+    backup: Backup<'_>,
+) -> Result<SaveOutcome, WriteError> {
+    save_stored_profile_on_channel(
+        shared.channel(),
+        shared.device_index(),
+        index,
+        original,
+        before,
+        after,
+        backup,
+    )
+    .await
+}
+
+/// Makes profile `index` the active one, switching it on in the profile list
+/// first if it is off (the mouse refuses to select a profile that is off).
+pub async fn select_stored_profile_on(
+    shared: &SharedChannel,
+    index: NonZeroU8,
+    backup: Backup<'_>,
+) -> Result<(), WriteError> {
+    select_stored_profile_on_channel(shared.channel(), shared.device_index(), index, backup).await
+}
+
+async fn open(
+    channel: &Arc<HidppChannel>,
+    index: u8,
+) -> Result<Arc<OnboardProfilesFeature>, WriteError> {
+    let mut device = Device::new(Arc::clone(channel), index)
+        .await
+        .map_err(|_| WriteError::DeviceUnreachable { index })?;
+    open_feature::<OnboardProfilesFeature>(&mut device).await
+}
+
+fn read_err(error: hidpp::protocol::v20::Hidpp20Error) -> WriteError {
+    classify_hidpp_error(error, HidppOperation::ReadOnboard, FEATURE)
+}
+
+fn write_err(error: hidpp::protocol::v20::Hidpp20Error) -> WriteError {
+    classify_hidpp_error(error, HidppOperation::WriteOnboard, FEATURE)
+}
+
+fn rejected(error: &ProfileError) -> WriteError {
+    WriteError::OnboardProfileRejected {
+        reason: error.to_string(),
+    }
+}
+
+/// Reads `sector` until two consecutive reads agree.
+async fn read_stable(
+    onboard: &OnboardProfilesFeature,
+    info: &OnboardProfilesInfo,
+    sector: u16,
+) -> Result<Vec<u8>, WriteError> {
+    let mut previous = onboard.read_sector(info, sector).await.map_err(read_err)?;
+    for _ in 1..STABLE_READ_ATTEMPTS {
+        let next = onboard.read_sector(info, sector).await.map_err(read_err)?;
+        if next == previous {
+            return Ok(next);
+        }
+        previous = next;
+    }
+    Err(WriteError::OnboardMemoryChanged)
+}
+
+/// The one way onboard memory is written. See the module docs.
+async fn guarded_write(
+    onboard: &OnboardProfilesFeature,
+    info: &OnboardProfilesInfo,
+    sector: u16,
+    original: &[u8],
+    updated: &[u8],
+    backup: Backup<'_>,
+) -> Result<SaveOutcome, WriteError> {
+    if updated == original {
+        return Ok(SaveOutcome::Unchanged);
+    }
+    if updated.len() != original.len() || !sector_checksum_ok(updated) {
+        return Err(WriteError::OnboardProfileRejected {
+            reason: "the new sector has no valid checksum".into(),
+        });
+    }
+    let now = read_stable(onboard, info, sector).await?;
+    if now != original {
+        return Err(WriteError::OnboardMemoryChanged);
+    }
+    if !sector_checksum_ok(&now) {
+        return Err(rejected(&ProfileError::Checksum));
+    }
+    if !backup(sector, original) {
+        return Err(WriteError::OnboardBackupFailed);
+    }
+    let stored = match onboard.write_sector(sector, updated).await {
+        Ok(()) => read_stable(onboard, info, sector).await.ok(),
+        Err(error) => {
+            warn!(sector, error = ?write_err(error), "onboard write failed; restoring");
+            None
+        }
+    };
+    if stored.as_deref() == Some(updated) {
+        return Ok(SaveOutcome::Saved);
+    }
+    let restored = match onboard.write_sector(sector, original).await {
+        Ok(()) => read_stable(onboard, info, sector).await.ok().as_deref() == Some(original),
+        Err(_) => false,
+    };
+    Err(WriteError::OnboardWriteNotStored { restored })
+}
+
+async fn read_stored_profiles_on_channel(
+    channel: &Arc<HidppChannel>,
+    index: u8,
+) -> Result<StoredProfiles, WriteError> {
+    let onboard = open(channel, index).await?;
+    let info = onboard.get_info().await.map_err(read_err)?;
+    let mode = onboard.get_mode().await.map_err(read_err)?;
+    let active = onboard.get_current_profile().await.map_err(read_err)?;
+    let dpi_values = match get_dpi_info_on_channel(channel, index).await {
+        Ok(dpi) => Some(
+            dpi.capabilities
+                .values()
+                .iter()
+                .filter_map(|&v| u16::try_from(u32::from(v)).ok())
+                .collect(),
+        ),
+        Err(error) => {
+            debug!(
+                ?error,
+                "DPI list unavailable; DPI levels are shown but not editable"
+            );
+            None
+        }
+    };
+    let decode_range = dpi_values
+        .as_ref()
+        .and_then(|v: &Vec<u16>| Some((*v.first()?, *v.last()?)))
+        .unwrap_or((1, u16::MAX));
+
+    let mut profiles = Vec::new();
+    for entry in onboard.read_directory(&info).await.map_err(read_err)? {
+        if entry.sector >= FIRST_ROM_SECTOR {
+            continue; // no user directory yet: the mouse runs its factory profiles
+        }
+        let raw = read_stable(&onboard, &info, entry.sector).await?;
+        let decoded =
+            StoredProfile::decode(&raw, info.profile_format, info.button_count, decode_range);
+        profiles.push(StoredProfileSlot {
+            index: entry.index,
+            sector: entry.sector,
+            enabled: entry.enabled,
+            raw,
+            decoded,
+        });
+    }
+
+    let factory_buttons = if info.profile_count_oob > 0 {
+        match onboard.read_sector(&info, FACTORY_PROFILE).await {
+            Ok(rom) => factory_bindings(&rom, info.button_count),
+            Err(error) => {
+                debug!(error = ?read_err(error), "factory profile unreadable");
+                Vec::new()
+            }
+        }
+    } else {
+        Vec::new()
+    };
+
+    // Read each sector a macro lives in once, then decode the macros from them.
+    let mut sectors: BTreeMap<u8, Option<Vec<u8>>> = BTreeMap::new();
+    let mut wanted = Vec::new();
+    for profile in profiles
+        .iter()
+        .filter_map(|slot| slot.decoded.as_ref().ok())
+    {
+        for binding in profile.buttons.iter().chain(&profile.shift_buttons) {
+            if let Binding::StoredMacro { sector, offset } = *binding {
+                wanted.push((sector, offset));
+                if let std::collections::btree_map::Entry::Vacant(slot) = sectors.entry(sector) {
+                    slot.insert(onboard.read_sector(&info, u16::from(sector)).await.ok());
+                }
+            }
+        }
+    }
+    let macros = wanted
+        .into_iter()
+        .map(|(sector, offset)| {
+            let steps = read_stored_macro(sector, usize::from(offset), |s| {
+                sectors.get(&s).cloned().flatten()
+            });
+            ((sector, offset), steps)
+        })
+        .collect();
+
+    Ok(StoredProfiles {
+        info,
+        mode,
+        active,
+        dpi_values,
+        profiles,
+        factory_buttons,
+        macros,
+    })
+}
+
+async fn save_stored_profile_on_channel(
+    channel: &Arc<HidppChannel>,
+    index: u8,
+    profile: NonZeroU8,
+    original: &[u8],
+    before: &StoredProfile,
+    after: &StoredProfile,
+    backup: Backup<'_>,
+) -> Result<SaveOutcome, WriteError> {
+    let onboard = open(channel, index).await?;
+    let info = onboard.get_info().await.map_err(read_err)?;
+    let sector = onboard
+        .read_directory(&info)
+        .await
+        .map_err(read_err)?
+        .into_iter()
+        .find(|entry| entry.index == profile && entry.sector < FIRST_ROM_SECTOR)
+        .map(|entry| entry.sector)
+        .ok_or_else(|| WriteError::OnboardProfileRejected {
+            reason: format!("profile {profile} is not a user profile"),
+        })?;
+    if after.dpi != before.dpi {
+        let values = get_dpi_info_on_channel(channel, index)
+            .await
+            .map(|dpi| dpi.capabilities);
+        let Ok(values) = values else {
+            return Err(WriteError::OnboardProfileRejected {
+                reason: "the sensor's DPI list couldn't be read".into(),
+            });
+        };
+        if let Some(&level) = after
+            .dpi
+            .iter()
+            .find(|&&level| level != 0 && !values.contains(level.into()))
+        {
+            return Err(WriteError::OnboardProfileRejected {
+                reason: format!("the sensor doesn't support {level} DPI"),
+            });
+        }
+    }
+    after.validate((1, u16::MAX), 0).map_err(|e| rejected(&e))?;
+    let updated = after
+        .encode_onto(original, before)
+        .map_err(|e| rejected(&e))?;
+    let outcome = guarded_write(&onboard, &info, sector, original, &updated, backup).await?;
+    if outcome == SaveOutcome::Saved
+        && onboard.get_current_profile().await.ok().flatten() == Some(profile)
+        && let Err(error) = onboard.set_current_profile(profile).await
+    {
+        // The new values are stored; the mouse picks them up on its next profile load.
+        debug!(error = ?write_err(error), "reloading the active profile failed");
+    }
+    Ok(outcome)
+}
+
+async fn select_stored_profile_on_channel(
+    channel: &Arc<HidppChannel>,
+    index: u8,
+    profile: NonZeroU8,
+    backup: Backup<'_>,
+) -> Result<(), WriteError> {
+    let onboard = open(channel, index).await?;
+    let info = onboard.get_info().await.map_err(read_err)?;
+    let entry = onboard
+        .read_directory(&info)
+        .await
+        .map_err(read_err)?
+        .into_iter()
+        .find(|entry| entry.index == profile)
+        .ok_or_else(|| WriteError::OnboardProfileRejected {
+            reason: format!("the mouse has no profile {profile}"),
+        })?;
+    if !entry.enabled {
+        let directory = read_stable(&onboard, &info, USER_DIRECTORY).await?;
+        let updated =
+            directory_with_enabled(&directory, profile, entry.sector).map_err(|e| rejected(&e))?;
+        guarded_write(
+            &onboard,
+            &info,
+            USER_DIRECTORY,
+            &directory,
+            &updated,
+            backup,
+        )
+        .await?;
+    }
+    onboard
+        .set_current_profile(profile)
+        .await
+        .map_err(write_err)
+}
