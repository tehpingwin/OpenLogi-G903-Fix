+//! One line under the binding inspector saying how the last write to a
+//! stored profile went, while a stored profile is in control.
+
+use gpui::{Context, ParentElement as _, SharedString, Styled as _, div};
+
+use super::view::MouseModelView;
+use crate::state::{AppState, StoredProfileNotice};
+use crate::ui::theme::{self, Typography as _};
+
+fn text(notice: &StoredProfileNotice) -> SharedString {
+    match notice {
+        StoredProfileNotice::Saved => tr!("stored_profile.saved"),
+        StoredProfileNotice::NothingToSave => tr!("stored_profile.nothing_to_save"),
+        StoredProfileNotice::Selected(index) => {
+            tr!("stored_profile.selected", number = index.get())
+        }
+        StoredProfileNotice::Failed(error) => {
+            tr!("stored_profile.failed", error = error.to_string())
+        }
+    }
+}
+
+pub(super) fn stored_status_line(cx: &Context<MouseModelView>) -> Option<gpui::Div> {
+    let state = AppState::try_read(cx)?;
+    state.stored_mode_bindings()?;
+    let pal = theme::palette(cx);
+    let line = if state.current_stored_profile_busy() {
+        tr!("stored_profile.saving")
+    } else {
+        text(state.current_stored_profile_notice()?)
+    };
+    Some(
+        div()
+            .px_3()
+            .text_caption()
+            .text_color(pal.text_muted)
+            .child(line),
+    )
+}
