+async fn set_stored_profiles_enabled_on_channel(
+    channel: &Arc<HidppChannel>,
+    index: u8,
+    changes: &[(NonZeroU8, bool)],
+    backup: Backup<'_>,
+) -> Result<(), WriteError> {
+    let onboard = open(channel, index).await?;
+    let info = onboard.get_info().await.map_err(read_err)?;
+    let entries = onboard.read_directory(&info).await.map_err(read_err)?;
+    if entries.iter().any(|entry| entry.sector >= FIRST_ROM_SECTOR) {
+        return Err(WriteError::OnboardProfileRejected {
+            reason: "the mouse runs its factory profiles; there is no profile list to change"
+                .into(),
+        });
+    }
+    let active = onboard.get_current_profile().await.map_err(read_err)?;
+    if changes
+        .iter()
+        .any(|&(profile, on)| !on && Some(profile) == active)
+    {
+        return Err(WriteError::OnboardProfileRejected {
+            reason: "the profile in use can't be switched off".into(),
+        });
+    }
+    let on_after = entries
+        .iter()
+        .filter(|entry| {
+            changes
+                .iter()
+                .find(|(profile, _)| *profile == entry.index)
+                .map_or(entry.enabled, |&(_, on)| on)
+        })
+        .count();
+    if on_after == 0 {
+        return Err(WriteError::OnboardProfileRejected {
+            reason: "at least one profile has to stay on".into(),
+        });
+    }
+    let directory = read_stable(&onboard, &info, USER_DIRECTORY).await?;
+    let updated = directory_with_flags(&directory, changes).map_err(|e| rejected(&e))?;
+    guarded_write(
