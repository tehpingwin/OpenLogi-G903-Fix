+//! Copies of a gaming mouse's onboard memory, saved before every write.
+//!
+//! Files land in `data_dir()/onboard-backups/<route>/sector-<hex>-<unix ms>.bin`.
+//! A backup is created new and never overwritten, then read back: the write
+//! only goes ahead when the copy on disk equals what was read from the mouse.
+//! The folder is named after the route, so a mouse moved to another receiver
+//! starts a new folder; the old copies stay where they are.
+
+use std::fs;
+use std::io::Write as _;
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use openlogi_core::hid::DeviceRoute;
+use openlogi_core::paths;
+use tracing::warn;
+
+const FOLDER: &str = "onboard-backups";
+
+/// The backup function for the mouse on `route`; `false` (nothing saved)
+/// stops the write.
+pub(super) fn sink(route: &DeviceRoute) -> impl Fn(u16, &[u8]) -> bool + Send + Sync + 'static {
+    let dir = paths::data_dir().map(|dir| dir.join(FOLDER).join(route_folder(route)));
+    move |sector, data| match &dir {
+        Ok(dir) => save(dir, sector, data),
+        Err(error) => {
+            warn!(?error, "no data directory for onboard backups");
+            false
+        }
+    }
+}
+
+fn route_folder(route: &DeviceRoute) -> String {
+    let name: String = format!("{route:?}")
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() { c } else { '_' })
+        .collect();
+    let name = name.trim_matches('_');
+    if name.is_empty() {
+        "device".to_owned()
+    } else {
+        name.to_owned()
+    }
+}
+
+fn save(dir: &Path, sector: u16, data: &[u8]) -> bool {
+    match try_save(dir, sector, data) {
+        Ok(path) => {
+            tracing::info!(path = %path.display(), "onboard memory backed up");
+            true
+        }
+        Err(error) => {
+            warn!(?error, dir = %dir.display(), "onboard backup failed; not writing");
+            false
+        }
+    }
+}
+
+fn try_save(dir: &Path, sector: u16, data: &[u8]) -> std::io::Result<PathBuf> {
+    fs::create_dir_all(dir)?;
+    let millis = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis());
+    for attempt in 0..100 {
+        let name = if attempt == 0 {
+            format!("sector-{sector:04x}-{millis}.bin")
+        } else {
+            format!("sector-{sector:04x}-{millis}-{attempt}.bin")
+        };
+        let path = dir.join(name);
+        let mut file = match fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)
+        {
+            Ok(file) => file,
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => continue,
+            Err(error) => return Err(error),
+        };
+        file.write_all(data)?;
+        file.sync_all()?;
+        drop(file);
+        if fs::read(&path)? != data {
+            return Err(std::io::Error::other(
+                "the backup on disk differs from the memory read",
+            ));
+        }
+        return Ok(path);
+    }
+    Err(std::io::Error::other("no free backup file name"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn temp_dir(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!(
+            "openlogi-backup-test-{name}-{}",
+            std::process::id()
+        ));
+        let _ = fs::remove_dir_all(&dir);
+        dir
+    }
+
+    #[test]
+    fn saves_new_files_and_never_overwrites() {
+        let dir = temp_dir("new");
+        assert!(save(&dir, 1, &[1, 2, 3]));
+        assert!(save(&dir, 1, &[4, 5, 6])); // same millisecond is likely: gets a suffix
+        let mut files: Vec<Vec<u8>> = fs::read_dir(&dir)
+            .unwrap()
+            .map(|e| fs::read(e.unwrap().path()).unwrap())
+            .collect();
+        files.sort();
+        assert_eq!(files, [vec![1, 2, 3], vec![4, 5, 6]]);
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn a_folder_that_cannot_be_made_refuses_the_write() {
+        let dir = temp_dir("blocked");
+        fs::write(&dir, b"a file where the folder should be").unwrap();
+        assert!(!save(&dir.join("inner"), 1, &[1]));
+        fs::remove_file(&dir).unwrap();
+    }
+
+    #[test]
+    fn route_folders_are_plain_names() {
+        let route = DeviceRoute::Bolt {
+            receiver_uid: "AB:CD/12".into(),
+            slot: 2,
+        };
+        let folder = route_folder(&route);
+        assert!(
+            folder
+                .chars()
+                .all(|c| c.is_ascii_alphanumeric() || c == '_')
+        );
+        assert!(folder.contains("Bolt") && folder.contains('2'));
+    }
+}
