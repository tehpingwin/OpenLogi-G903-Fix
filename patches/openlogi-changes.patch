@@ -1,435 +0,0 @@
-//! "Stored in the mouse": the stored profile's own button bindings, edited
-//! and saved into the mouse, so they work without OpenLogi running. Shown
-//! under the binding inspector while a stored profile is in control.
-
-use gpui::{
-    App, Context, IntoElement, ParentElement, Role, SharedString, Styled, div,
-    prelude::FluentBuilder as _,
-};
-use gpui_kit::component::{Disableable as _, Selectable as _, h_flex, v_flex};
-use openlogi_core::config::OnboardMemory;
-use openlogi_core::hid::{ProfileIndex, StoredBinding, StoredMacroStep, StoredProfiles};
-
-use super::view::MouseModelView;
-use crate::state::{AppState, Load, StoredProfileNotice};
-use crate::ui::components::{MenuRow, ProfileTab, control_button};
-use crate::ui::section::section_label;
-use crate::ui::theme::{self, Typography as _};
-
-const MOUSE: [(u8, &str); 5] = [
-    (1, "actions.left_click"),
-    (2, "actions.right_click"),
-    (3, "actions.middle_click"),
-    (4, "actions.back"),
-    (5, "actions.forward"),
-];
-const MEDIA: [(u16, &str); 6] = [
-    (0xcd, "actions.play_pause"),
-    (0xb5, "actions.next_track"),
-    (0xb6, "actions.previous_track"),
-    (0xe9, "actions.volume_up"),
-    (0xea, "actions.volume_down"),
-    (0xe2, "actions.mute"),
-];
-const FUNCTIONS: [(u8, &str); 11] = [
-    (0x03, "pointer.next_dpi_preset"),
-    (0x04, "pointer.previous_dpi_preset"),
-    (0x05, "pointer.cycle_dpi_presets"),
-    (0x07, "pointer.dpi_shift"),
-    (0x08, "stored_profile.next_profile"),
-    (0x09, "stored_profile.previous_profile"),
-    (0x0a, "stored_profile.cycle_profiles"),
-    (0x0b, "actions.g_shift_hold"),
-    (0x0c, "stored_profile.battery_level"),
-    (0x01, "actions.scroll_left"),
-    (0x02, "actions.scroll_right"),
-];
-
-/// A key name for a HID usage (page 7). Key names stay in English, as on
-/// the keycaps.
-fn key_name(usage: u8) -> String {
-    match usage {
-        0x04..=0x1d => char::from(b'A' + (usage - 0x04)).to_string(),
-        0x1e..=0x26 => char::from(b'1' + (usage - 0x1e)).to_string(),
-        0x27 => "0".into(),
-        0x3a..=0x45 => format!("F{}", usage - 0x3a + 1),
-        0x68..=0x73 => format!("F{}", usage - 0x68 + 13),
-        0x28 => "Enter".into(),
-        0x29 => "Esc".into(),
-        0x2a => "Backspace".into(),
-        0x2b => "Tab".into(),
-        0x2c => "Space".into(),
-        0x46 => "Print Screen".into(),
-        0x49 => "Insert".into(),
-        0x4a => "Home".into(),
-        0x4b => "Page Up".into(),
-        0x4c => "Delete".into(),
-        0x4d => "End".into(),
-        0x4e => "Page Down".into(),
-        0x4f => "Right".into(),
-        0x50 => "Left".into(),
-        0x51 => "Down".into(),
-        0x52 => "Up".into(),
-        0xe0 | 0xe4 => "Ctrl".into(),
-        0xe1 | 0xe5 => "Shift".into(),
-        0xe2 | 0xe6 => "Alt".into(),
-        0xe3 | 0xe7 => "Win".into(),
-        other => format!("Key {other:02X}"),
-    }
-}
-
-fn key_combo(modifiers: u8, usage: u8) -> String {
-    let mut parts = Vec::new();
-    for (bits, name) in [
-        (0x11, "Ctrl"),
-        (0x22, "Shift"),
-        (0x44, "Alt"),
-        (0x88, "Win"),
-    ] {
-        if modifiers & bits != 0 {
-            parts.push(name.to_owned());
-        }
-    }
-    parts.push(key_name(usage));
-    parts.join(" + ")
-}
-
-/// "Ctrl + Tab" for a stored macro: the keys held when the first one of a
-/// chord is released, chord by chord.
-fn macro_keys(steps: &[StoredMacroStep]) -> String {
-    let mut held: Vec<u8> = Vec::new();
-    let mut chords: Vec<String> = Vec::new();
-    let mut emitted = false;
-    for step in steps {
-        match *step {
-            StoredMacroStep::KeyDown(_, usage) => {
-                held.push(usage);
-                emitted = false;
-            }
-            StoredMacroStep::KeyUp(_, usage) => {
-                if !emitted && !held.is_empty() {
-                    chords.push(
-                        held.iter()
-                            .map(|&u| key_name(u))
-                            .collect::<Vec<_>>()
-                            .join(" + "),
-                    );
-                    emitted = true;
-                }
-                held.retain(|&u| u != usage);
-            }
-            StoredMacroStep::Delay(_) => {}
-        }
-    }
-    chords.join(", ")
-}
-
-fn binding_label(binding: StoredBinding, profiles: &StoredProfiles) -> SharedString {
-    match binding {
-        StoredBinding::MouseButton(n) => MOUSE.iter().find(|(v, _)| *v == n).map_or_else(
-            || tr!("stored_profile.mouse_button", number = n),
-            |(_, key)| tr!(*key),
-        ),
-        StoredBinding::Key { modifiers, usage } => key_combo(modifiers, usage).into(),
-        StoredBinding::Consumer(code) => MEDIA.iter().find(|(v, _)| *v == code).map_or_else(
-            || tr!("stored_profile.media_key", code = format!("{code:04X}")),
-            |(_, key)| tr!(*key),
-        ),
-        StoredBinding::Special { function, .. } => {
-            FUNCTIONS.iter().find(|(v, _)| *v == function).map_or_else(
-                || tr!("stored_profile.function", number = function),
-                |(_, key)| tr!(*key),
-            )
-        }
-        StoredBinding::StoredMacro { sector, offset } => {
-            match profiles
-                .stored_macro(sector, offset)
-                .and_then(|m| m.steps.as_ref().ok())
-            {
-                Some(steps) if !steps.is_empty() => {
-                    tr!("stored_profile.macro", keys = macro_keys(steps))
-                }
-                _ => tr!("stored_profile.macro_stored"),
-            }
-        }
-        StoredBinding::Disabled => tr!("pointer.do_nothing"),
-        StoredBinding::Other(_) => tr!("stored_profile.other"),
-    }
-}
