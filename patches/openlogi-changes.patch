+            .filter(|index| profiles.profiles.iter().any(|slot| slot.index == *index))
+            .or(profiles.active)
+            .or_else(|| profiles.profiles.first().map(|slot| slot.index))
+    }
+
+    /// The button whose choices are open in the editor.
+    #[must_use]
+    pub fn current_stored_open_button(&self) -> Option<usize> {
+        self.current_record()
+            .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))
+            .and_then(|entry| entry.open_button)
+    }
+
+    /// Show profile `index` in the editor. An unsaved edit of another
+    /// profile is dropped.
+    pub fn show_stored_profile(&mut self, index: ProfileIndex) -> StateEvents {
+        let events = self.for_current_device(StateEvent::OnboardChanged);
+        if let Some(key) = self.current_record().map(DeviceRecord::device_key) {
+            let entry = self.stored_profiles.entry(&key);
+            entry.shown = Some(index);
+            entry.open_button = None;
+            entry.notice = None;
+            if entry.edit.as_ref().is_some_and(|edit| edit.index != index) {
+                entry.edit = None;
+            }
+        }
+        events
+    }
+
+    /// Open the choices of `button` in the editor, or close them (`None`, or
+    /// the button already open).
+    pub fn open_stored_button(&mut self, button: Option<usize>) -> StateEvents {
+        let events = self.for_current_device(StateEvent::OnboardChanged);
+        if let Some(key) = self.current_record().map(DeviceRecord::device_key) {
+            let entry = self.stored_profiles.entry(&key);
+            entry.open_button = if entry.open_button == button {
+                None
+            } else {
+                button
+            };
+        }
+        events
+    }
