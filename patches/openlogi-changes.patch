+/// Whether a battery is low by the user's level: not charging and at or below
+/// it, or, without a percentage, at a level the device calls low.
+fn low(battery: &BatteryInfo, levels: Levels) -> bool {
+    !charging(battery)
+        && battery
+            .percentage
+            .map_or_else(|| battery.needs_attention(), |charge| charge <= levels.warn)
+}
+
+/// Whether a battery has been charged since it was low: it is charging now,
+/// it reads the re-arm level or more, or, without a percentage, its level is
+/// good or full again.
+fn recharged(battery: &BatteryInfo, levels: Levels) -> bool {
