+/// The display the agent last asked notices to show on.
+static DISPLAY: std::sync::Mutex<openlogi_core::config::NoticeDisplay> =
+    std::sync::Mutex::new(openlogi_core::config::NoticeDisplay::Pointer);
+
+/// Record the display the agent asks notices to show on.
+pub(crate) fn set_display(display: openlogi_core::config::NoticeDisplay) {
+    if let Ok(mut current) = DISPLAY.lock() {
+        *current = display;
+    }
+}
+
+/// The display notices show on.
+#[cfg_attr(
+    not(target_os = "windows"),
+    expect(
+        dead_code,
+        reason = "only the Windows placement chooses a display so far"
+    )
+)]
+pub(crate) fn display() -> openlogi_core::config::NoticeDisplay {
+    DISPLAY
+        .lock()
+        .map_or_else(|_| openlogi_core::config::NoticeDisplay::Pointer, |d| *d)
+}
