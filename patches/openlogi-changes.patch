+/// The profile directory `dir` with the on/off flags in `changes` applied,
+/// checksum renewed. Only those entries' flag bytes change. Refuses an entry
+/// the directory doesn't hold (an empty `ffff` slot).
+pub fn directory_with_flags(
+    dir: &[u8],
+    changes: &[(NonZeroU8, bool)],
+) -> Result<Vec<u8>, ProfileError> {
+    if !sector_checksum_ok(dir) {
+        return Err(ProfileError::Checksum);
+    }
+    let mut out = dir.to_vec();
+    for &(index, enabled) in changes {
+        let entry = 4 * usize::from(index.get() - 1);
+        if entry + 3 >= dir.len().saturating_sub(2) || dir[entry..entry + 2] == [0xff, 0xff] {
+            return Err(ProfileError::Implausible(
+                "the profile list has no such profile",
+            ));
+        }
+        out[entry + 2] = u8::from(enabled);
+    }
+    seal_sector(&mut out);
+    Ok(out)
+}
