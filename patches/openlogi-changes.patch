From 2c7b750651c122314d24321f870e619be7668c56 Mon Sep 17 00:00:00 2001
From: OpenLogi contributor <contributor@localhost>
Date: Wed, 25 Nov 2026 14:55:16 +0000
Subject: [PATCH 08/19] fix(desktop): show a stored-profile change at once, and
 keep quick ones

After a save the editor dropped the edit and showed the read from
before the save until the mouse was read again, so a new report rate
or binding appeared only after a second click. It now shows what the
save wrote until the read confirms it.

A change made while a save is in flight is kept and saved right after
the read, on the bytes the mouse holds by then, instead of being sent
on a stale base or dropped.

The report-rate row and the button labels are told when stored
settings change (they only listened for their own events).
---
 .../src/state/stored_profiles.rs              | 148 +++++++++++++-----
 .../src/state/tests/stored_profiles.rs        |  75 +++++++++
 2 files changed, 183 insertions(+), 40 deletions(-)

diff --git a/crates/openlogi-desktop/src/state/stored_profiles.rs b/crates/openlogi-desktop/src/state/stored_profiles.rs
index b841cff2..39e59d41 100644
--- a/crates/openlogi-desktop/src/state/stored_profiles.rs
+++ b/crates/openlogi-desktop/src/state/stored_profiles.rs
@@ -79,6 +79,45 @@ struct Entry {
     selecting: Option<ProfileIndex>,
     toggling: bool,
     notice: Option<StoredProfileNotice>,
+    /// The settings of the save in flight.
+    in_flight: Option<(ProfileIndex, StoredProfileSettings)>,
+    /// What the last save wrote, shown until the next read confirms it: the
+    /// read from before the save is stale until then.
+    applied: Option<(ProfileIndex, StoredProfileSettings)>,
+    /// An edit made while a save was in flight, saved once the mouse has been
+    /// read again (on the bytes the mouse holds by then).
+    resave: bool,
+}
+
+impl Entry {
+    /// What profile `index` holds without the edit: what the last save wrote
+    /// (until a read confirms it), else the read.
+    fn known(&self, index: ProfileIndex) -> Option<&StoredProfileSettings> {
+        if let Some((applied, settings)) = &self.applied
+            && *applied == index
+        {
+            return Some(settings);
+        }
+        let Load::Ready(profiles) = &self.load else {
+            return None;
+        };
+        profiles
+            .profiles
+            .iter()
+            .find(|slot| slot.index == index)?
+            .settings
+            .as_ref()
+            .ok()
+    }
+
+    /// What profile `index` does as far as the editor knows: the edit, else
+    /// [`Self::known`].
+    fn settings(&self, index: ProfileIndex) -> Option<&StoredProfileSettings> {
+        match &self.edit {
+            Some(edit) if edit.index == index => Some(&edit.settings),
+            _ => self.known(index),
+        }
+    }
 }
 
 /// Every mouse's stored-profile editor state.
@@ -178,16 +217,7 @@ impl AppState {
         let Load::Ready(profiles) = &entry.load else {
             return None;
         };
-        let settings = match &entry.edit {
-            Some(edit) if edit.index == active => &edit.settings,
-            _ => profiles
-                .profiles
-                .iter()
-                .find(|slot| slot.index == active)?
-                .settings
-                .as_ref()
-                .ok()?,
-        };
+        let settings = entry.settings(active)?;
         let layer = if gshift {
             &settings.shift_buttons
         } else {
@@ -249,22 +279,7 @@ impl AppState {
         let entry = self
             .current_record()
             .and_then(|record| self.stored_profiles.entries.get(&record.device_key()))?;
-        let Load::Ready(profiles) = &entry.load else {
-            return None;
-        };
-        let interval = match &entry.edit {
-            Some(edit) if edit.index == active => edit.settings.report_interval_ms,
-            _ => {
-                profiles
-                    .profiles
-                    .iter()
-                    .find(|slot| slot.index == active)?
-                    .settings
-                    .as_ref()
-                    .ok()?
-                    .report_interval_ms
-            }
-        };
+        let interval = entry.settings(active)?.report_interval_ms;
         (interval > 0).then(|| 1000 / u16::from(interval))
     }
 
@@ -392,7 +407,33 @@ impl AppState {
                     return; // a newer read is in flight
                 }
                 entry.load = load_from(result);
-                cx.emit(StateEvent::OnboardChanged(key.clone()));
+                entry.applied = None;
+                // An edit still open was made on top of what the mouse holds
+                // now: take the fresh bytes as its base.
+                if let (Load::Ready(profiles), Some(edit)) = (&entry.load, entry.edit.as_mut())
+                    && let Some(slot) = profiles
+                        .profiles
+                        .iter()
+                        .find(|slot| slot.index == edit.index)
+                    && let Ok(settings) = &slot.settings
+                {
+                    edit.base = slot.base.clone();
+                    edit.original = settings.clone();
+                }
+                let resave = std::mem::take(&mut entry.resave);
+                if entry.edit.as_ref().is_some_and(|edit| !edit.is_dirty()) {
+                    entry.edit = None;
+                }
+                for event in [
+                    StateEvent::OnboardChanged,
+                    StateEvent::BindingsChanged,
+                    StateEvent::ReportRateChanged,
+                ] {
+                    cx.emit(event(key.clone()));
+                }
+                if resave && state.is_current_device(&key) {
+                    let _ = state.save_stored_profile_edit();
+                }
             });
         })
         .detach();
@@ -421,14 +462,18 @@ impl AppState {
             let Some(slot) = profiles.profiles.iter().find(|slot| slot.index == index) else {
                 return events;
             };
-            let Ok(settings) = &slot.settings else {
+            if slot.settings.is_err() {
                 return events; // shown, but not editable
+            }
+            let base = slot.base.clone();
+            let Some(known) = entry.known(index).cloned() else {
+                return events;
             };
             entry.edit = Some(StoredProfileEdit {
                 index,
-                settings: settings.clone(),
-                original: settings.clone(),
-                base: slot.base.clone(),
+                settings: known.clone(),
