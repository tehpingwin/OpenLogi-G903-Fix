+        let Some((key, route)) = self.stored_profile_target() else {
+            return events;
+        };
+        let entry = self.stored_profiles.entry(&key);
+        if changes.is_empty() || entry.toggling || entry.saving.is_some() {
+            return events;
+        }
+        entry.toggling = true;
+        entry.notice = None;
+        if !self.send_ipc(SetStoredProfilesEnabled {
+            route,
+            key: key.clone(),
+            changes,
