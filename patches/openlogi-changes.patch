+/// How long the low-battery notice stays on screen.
+fn low_battery_notice_seconds_item() -> SettingItem {
+    SettingItem::new(
+        tr!("app.low_battery_notice_seconds"),
+        SettingField::number_input(
+            gpui_kit::component::setting::NumberFieldOptions {
+                min: 2.0,
+                max: 600.0,
+                step: 1.0,
+            },
+            |cx| {
+                AppState::try_read(cx).map_or(8.0, |s| {
+                    f64::from(s.app_settings().low_battery_notice_seconds)
+                })
+            },
+            |value, cx| {
+                AppState::apply(cx, |state| {
+                    state.commit_low_battery_notice_seconds(seconds(value))
+                });
+            },
+        ),
+    )
+    .description(tr!("app.low_battery_notice_seconds_description"))
+}
+
+/// A number field's value as whole seconds.
+#[expect(
+    clippy::cast_possible_truncation,
+    clippy::cast_sign_loss,
+    reason = "clamped to 0..=600 first"
+)]
+fn seconds(value: f64) -> u16 {
+    value.clamp(0.0, 600.0).round() as u16
+}
