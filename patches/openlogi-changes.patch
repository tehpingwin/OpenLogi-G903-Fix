@@ -0,0 +1,299 @@
+//! The stored-profile editor: the read lands, an edit saves through the
+//! agent with the bytes it started from, and every answer is matched to the
+//! request it answers.
+
+use super::fn_lock::drain;
+use super::pointer_speed::install;
+use super::*;
+use crate::services::ipc::{Command, ReadStoredProfiles, SaveStoredProfile, SelectStoredProfile};
+use crate::state::{StoredProfileNotice, StoredProfilesLoad};
+use openlogi_core::hid::{
+    OnboardMode, ProfileIndex, StoredBinding, StoredLed, StoredProfileSave, StoredProfileSettings,
+    StoredProfileSlot, StoredProfiles, WriteError,
+};
+
+fn index(n: u8) -> ProfileIndex {
+    ProfileIndex::new(n).expect("a profile number")
+}
+
+/// A direct G-series mouse with onboard memory.
+fn mouse_inventory() -> DeviceInventory {
+    let mut inventory = direct_inventory([0x9d, 0xa8, 0x1d, 0x11]);
+    inventory.paired[0].kind = DeviceKind::Mouse;
+    inventory.paired[0].capabilities = Some(Capabilities {
+        onboard_profiles: true,
+        ..Capabilities::default()
+    });
+    inventory
+}
+
+fn mouse_state() -> (AppState, tokio::sync::mpsc::UnboundedReceiver<Command>) {
+    let resolver = AssetResolver::new();
+    let (commands, receiver) = tokio::sync::mpsc::unbounded_channel();
+    let state = AppState::new(Sources {
+        inventories: &[mouse_inventory()],
+        ..Sources::in_memory(Config::ephemeral(), &resolver, commands)
+    });
+    (state, receiver)
+}
+
+fn settings() -> StoredProfileSettings {
+    StoredProfileSettings {
+        report_interval_ms: 8,
+        default_dpi_level: 0,
+        shift_dpi_level: Some(0),
+        dpi: [1800, 0, 0, 0, 0],
+        leds: [StoredLed::Off; 2],
+        power_save_leds: [StoredLed::Off; 2],
+        buttons: vec![
+            StoredBinding::MouseButton(1),
+            StoredBinding::MouseButton(2),
+            StoredBinding::Key {
+                modifiers: 0,
+                usage: 0x28,
+            },
+        ],
+        shift_buttons: vec![StoredBinding::Disabled; 3],
+    }
+}
+
+fn profiles(active: u8) -> StoredProfiles {
+    StoredProfiles {
+        mode: OnboardMode::Onboard,
+        active: Some(index(active)),
+        dpi_values: Some((100..=25_600).step_by(50).collect()),
+        profiles: vec![
+            StoredProfileSlot {
+                index: index(1),
+                enabled: true,
+                base: vec![1; 255],
+                settings: Ok(settings()),
+            },
+            StoredProfileSlot {
+                index: index(2),
+                enabled: false,
+                base: vec![2; 255],
+                settings: Err("its checksum doesn't match".into()),
+            },
+        ],
+        factory_buttons: vec![StoredBinding::MouseButton(1); 3],
+        macros: Vec::new(),
+    }
+}
+
+/// Answer the stored-profile read the state has queued; every other command
+/// is dropped.
+fn answer_read(
+    receiver: &mut tokio::sync::mpsc::UnboundedReceiver<Command>,
+    answer: Result<StoredProfiles, WriteError>,
+) {
+    let mut answered = false;
+    for command in drain(receiver) {
+        if let Command::ReadStoredProfiles(ReadStoredProfiles { reply, .. }) = command {
+            assert!(!answered, "one stored-profile read at a time");
+            let _ = reply.send(answer.clone());
+            answered = true;
+        }
+    }
+    assert!(answered, "the state read the stored profiles");
+}
+
+fn take_save(receiver: &mut tokio::sync::mpsc::UnboundedReceiver<Command>) -> SaveStoredProfile {
+    let mut saves = drain(receiver)
+        .into_iter()
+        .filter_map(|command| match command {
+            Command::SaveStoredProfile(save) => Some(save),
+            _ => None,
+        });
+    let save = saves.next().expect("a save was sent");
+    assert!(saves.next().is_none(), "one save at a time");
+    save
+}
+
+fn load(cx: &gpui::TestAppContext) -> StoredProfilesLoad {
+    cx.read(|cx| {
+        AppState::try_read(cx)
+            .expect("state")
+            .current_stored_profiles()
+    })
+}
+
+fn notice(cx: &gpui::TestAppContext) -> Option<StoredProfileNotice> {
+    cx.read(|cx| {
+        AppState::try_read(cx)
+            .expect("state")
+            .current_stored_profile_notice()
+            .cloned()
+    })
+}
+
+fn dirty(cx: &gpui::TestAppContext) -> Option<bool> {
+    cx.read(|cx| {
+        AppState::try_read(cx)
+            .expect("state")
+            .current_stored_profile_edit()
+            .map(|edit| edit.is_dirty())
+    })
+}
+
+/// A mouse whose stored profiles have been read.
+fn ready(
+    cx: &mut gpui::TestAppContext,
+) -> (DeviceKey, tokio::sync::mpsc::UnboundedReceiver<Command>) {
+    let (state, mut receiver) = mouse_state();
+    let key = state.current_record().expect("mouse").device_key();
+    install(state, cx);
+    answer_read(&mut receiver, Ok(profiles(1)));
+    cx.run_until_parked();
+    (key, receiver)
+}
+
+fn edit_enter_to_play(cx: &mut gpui::TestAppContext) {
+    let _ = cx.update(|cx| {
+        AppState::update(cx, |state, _| {
+            state.edit_stored_profile(index(1), |s| s.buttons[2] = StoredBinding::Consumer(0xcd))
+        })
+    });
+}
+
+#[gpui::test]
+fn the_read_lands_for_a_mouse_with_onboard_memory(cx: &mut gpui::TestAppContext) {
+    let (_key, _receiver) = ready(cx);
+    assert!(matches!(load(cx), Load::Ready(p) if p.profiles.len() == 2));
+}
+
+#[gpui::test]
+fn an_unsupported_mouse_reads_as_unsupported(cx: &mut gpui::TestAppContext) {
+    let (state, mut receiver) = mouse_state();
+    install(state, cx);
+    answer_read(
+        &mut receiver,
+        Err(WriteError::FeatureUnsupported {
+            feature_hex: 0x8100,
+        }),
+    );
+    cx.run_until_parked();
+    assert!(matches!(load(cx), Load::Unsupported(_)));
+}
+
+#[gpui::test]
+fn an_edit_saves_with_the_bytes_it_started_from(cx: &mut gpui::TestAppContext) {
+    let (key, mut receiver) = ready(cx);
+    edit_enter_to_play(cx);
+    assert_eq!(dirty(cx), Some(true));
+    let _ = cx.update(|cx| AppState::update(cx, |state, _| state.save_stored_profile_edit()));
+    let save = take_save(&mut receiver);
+    assert_eq!(save.index, index(1));
+    assert_eq!(save.base, vec![1; 255]);
+    assert_eq!(save.settings.buttons[2], StoredBinding::Consumer(0xcd));
+
+    cx.update(|cx| {
+        AppState::update(cx, |state, cx| {
+            state.apply_stored_profile_saved(&key, save.request, Ok(StoredProfileSave::Saved), cx);
+        });
+    });
+    assert_eq!(notice(cx), Some(StoredProfileNotice::Saved));
+    assert_eq!(dirty(cx), None, "the edit is done");
+    answer_read(&mut receiver, Ok(profiles(1))); // read again after the save
+}
+
+#[gpui::test]
+fn an_unchanged_edit_sends_nothing(cx: &mut gpui::TestAppContext) {
+    let (_key, mut receiver) = ready(cx);
+    let _ = cx.update(|cx| {
+        AppState::update(cx, |state, _| {
+            state.edit_stored_profile(index(1), |_| {});
+            state.save_stored_profile_edit()
+        })
+    });
+    // Other device reads may be queued; what matters is that no save went out.
+    assert!(
+        !drain(&mut receiver)
+            .iter()
+            .any(|command| matches!(command, Command::SaveStoredProfile(_))),
+        "an unchanged edit sends no save"
+    );
+    assert_eq!(notice(cx), Some(StoredProfileNotice::NothingToSave));
+}
+
+#[gpui::test]
+fn a_profile_that_cannot_be_decoded_cannot_be_edited(cx: &mut gpui::TestAppContext) {
+    let (_key, _receiver) = ready(cx);
+    let _ = cx
+        .update(|cx| AppState::update(cx, |state, _| state.edit_stored_profile(index(2), |_| {})));
+    assert_eq!(dirty(cx), None);
+}
+
+#[gpui::test]
+fn a_refused_save_keeps_the_edit_unless_its_base_is_stale(cx: &mut gpui::TestAppContext) {
+    let (key, mut receiver) = ready(cx);
+    edit_enter_to_play(cx);
+    let _ = cx.update(|cx| AppState::update(cx, |state, _| state.save_stored_profile_edit()));
+    let save = take_save(&mut receiver);
+    let not_stored = WriteError::OnboardWriteNotStored { restored: true };
+    cx.update(|cx| {
+        AppState::update(cx, |state, cx| {
+            state.apply_stored_profile_saved(&key, save.request, Err(not_stored.clone()), cx);
+        });
+    });
+    assert_eq!(notice(cx), Some(StoredProfileNotice::Failed(not_stored)));
+    assert_eq!(dirty(cx), Some(true), "nothing typed is lost");
+    answer_read(&mut receiver, Ok(profiles(1)));
+
+    let _ = cx.update(|cx| AppState::update(cx, |state, _| state.save_stored_profile_edit()));
+    let save = take_save(&mut receiver);
+    cx.update(|cx| {
+        AppState::update(cx, |state, cx| {
+            state.apply_stored_profile_saved(
+                &key,
+                save.request,
+                Err(WriteError::OnboardMemoryChanged),
+                cx,
+            );
+        });
+    });
+    assert_eq!(dirty(cx), None, "an edit on a stale read starts over");
+}
+
+#[gpui::test]
+fn a_late_answer_to_another_save_is_ignored(cx: &mut gpui::TestAppContext) {
+    let (key, mut receiver) = ready(cx);
+    edit_enter_to_play(cx);
+    let _ = cx.update(|cx| AppState::update(cx, |state, _| state.save_stored_profile_edit()));
+    let save = take_save(&mut receiver);
+    cx.update(|cx| {
+        AppState::update(cx, |state, cx| {
+            state.apply_stored_profile_saved(
+                &key,
+                save.request + 99,
+                Ok(StoredProfileSave::Saved),
+                cx,
+            );
+        });
+    });
+    assert_eq!(notice(cx), None);
+    assert_eq!(dirty(cx), Some(true));
+}
+
+#[gpui::test]
+fn selecting_a_profile_asks_the_agent_and_reads_again(cx: &mut gpui::TestAppContext) {
+    let (key, mut receiver) = ready(cx);
+    let _ = cx.update(|cx| AppState::update(cx, |state, _| state.select_stored_profile(index(2))));
+    let selected: Vec<_> = drain(&mut receiver)
+        .into_iter()
+        .filter_map(|command| match command {
+            Command::SelectStoredProfile(SelectStoredProfile { index, .. }) => Some(index),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(selected, [index(2)]);
+    cx.update(|cx| {
+        AppState::update(cx, |state, cx| {
+            state.apply_stored_profile_selected(&key, index(2), Ok(()), cx)
+        });
+    });
+    assert_eq!(notice(cx), Some(StoredProfileNotice::Selected(index(2))));
+    answer_read(&mut receiver, Ok(profiles(2)));
+    cx.run_until_parked();
+    assert!(matches!(load(cx), Load::Ready(p) if p.active == Some(index(2))));
+}
