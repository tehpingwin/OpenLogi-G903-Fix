+/// One switch per stored profile, and "Enable all". The profile in use, and
+/// the last profile left on, can't be switched off: the mouse needs one.
+fn stored_profile_switches(
+    reading: &openlogi_core::hid::OnboardState,
+    busy: bool,
+    pal: Palette,
+) -> impl IntoElement {
+    let on = reading.profiles.iter().filter(|p| p.enabled).count();
+    let pills = reading.profiles.iter().map(|p| {
+        let index = p.index;
+        let enabled = p.enabled;
+        let locked = enabled && (Some(index) == reading.active_profile || on <= 1);
+        let label = p.name.clone().unwrap_or_else(|| {
+            tr!("pointer.onboard_profile_number", number => index.to_string()).to_string()
+        });
+        crate::ui::components::Pill::new(
+            ("stored-profile-switch", usize::from(index.get().get())),
+            label,
+        )
+        .selected(enabled)
+        .disabled(busy || locked)
+        .on_click(move |_, _, cx| {
+            AppState::apply(cx, |state| {
+                state.set_stored_profiles_enabled(vec![(index, !enabled)])
+            });
+        })
+    });
+    let off: Vec<_> = reading
+        .profiles
+        .iter()
+        .filter(|p| !p.enabled)
+        .map(|p| (p.index, true))
+        .collect();
+    let all_on = off.is_empty();
+    v_flex()
+        .gap_2()
+        .child(h_flex().gap_2().flex_wrap().children(pills))
+        .child(
+            h_flex().child(
+                crate::ui::components::control_button("stored-profiles-enable-all")
+                    .label(tr!("stored_profile.enable_all"))
+                    .disabled(busy || all_on)
+                    .on_click(move |_, _, cx| {
+                        AppState::apply(cx, |state| state.set_stored_profiles_enabled(off.clone()));
+                    }),
+            ),
+        )
+        .child(
+            div()
+                .text_caption()
+                .text_color(pal.text_muted)
+                .child(if busy {
+                    tr!("stored_profile.saving")
+                } else {
+                    SharedString::default()
+                }),
+        )
+}
