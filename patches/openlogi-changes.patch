diff --git a/crates/openlogi-desktop/src/state/stored_actions.rs b/crates/openlogi-desktop/src/state/stored_actions.rs
new file mode 100644
index 00000000..b31d7af2
--- /dev/null
+++ b/crates/openlogi-desktop/src/state/stored_actions.rs
@@ -0,0 +1,339 @@
+//! Between OpenLogi's [`Action`]s and what a G-series mouse can store in a
+//! profile: mouse buttons, key combinations, media keys and a few firmware
+//! functions. While a stored profile is in control, the Buttons panel shows
+//! the stored bindings as actions and offers only the actions a profile can
+//! hold.
+
+use std::sync::LazyLock;
+
+use openlogi_core::binding::{Action, KeyCombo, KeyboardUsage, Modifiers};
+use openlogi_core::hid::{StoredBinding, StoredMacroStep, StoredProfiles};
+
+/// Boot-keyboard modifier bits: left Ctrl, Shift, Alt, GUI; the right-hand
+/// ones are the same shifted four up.
+const CTRL: u8 = 0x01;
+const SHIFT: u8 = 0x02;
+const ALT: u8 = 0x04;
+const GUI: u8 = 0x08;
+
+/// The platform's primary modifier, as the mouse stores it: Command on macOS,
+/// Control elsewhere.
+const PRIMARY: u8 = if cfg!(target_os = "macos") { GUI } else { CTRL };
+
+const TAB: u8 = 0x2b;
+
+/// Shortcut actions and the chord each stands for (modifiers, HID usage).
+const SHORTCUTS: [(Action, u8, u8); 13] = [
+    (Action::Copy, PRIMARY, 0x06),
+    (Action::Paste, PRIMARY, 0x19),
+    (Action::Cut, PRIMARY, 0x1b),
+    (Action::Undo, PRIMARY, 0x1d),
+    (Action::SelectAll, PRIMARY, 0x04),
+    (Action::Find, PRIMARY, 0x09),
+    (Action::Save, PRIMARY, 0x16),
+    (Action::NewTab, PRIMARY, 0x17),
+    (Action::CloseTab, PRIMARY, 0x1a),
+    (Action::ReopenTab, PRIMARY | SHIFT, 0x17),
+    (Action::NextTab, CTRL, TAB),
+    (Action::PrevTab, CTRL | SHIFT, TAB),
+    (Action::ReloadPage, PRIMARY, 0x15),
+];
+
+const MOUSE: [(Action, u8); 5] = [
+    (Action::LeftClick, 1),
+    (Action::RightClick, 2),
+    (Action::MiddleClick, 3),
+    (Action::MouseBack, 4),
+    (Action::MouseForward, 5),
+];
+
+const MEDIA: [(Action, u16); 8] = [
+    (Action::PlayPause, 0xcd),
+    (Action::NextTrack, 0xb5),
+    (Action::PrevTrack, 0xb6),
+    (Action::VolumeUp, 0xe9),
+    (Action::VolumeDown, 0xea),
+    (Action::MuteVolume, 0xe2),
+    (Action::BrowserBack, 0x224),
+    (Action::BrowserForward, 0x225),
+];
+
+/// Firmware functions with an action of their own. Profile switching and the
+/// battery check have none: they are shown as stored, not offered.
+const FUNCTIONS: [(Action, u8); 7] = [
+    (Action::NextDpiPreset, 0x03),
+    (Action::PreviousDpiPreset, 0x04),
+    (Action::CycleDpiPresets, 0x05),
+    (Action::DpiShift, 0x07),
+    (Action::GShift, 0x0b),
+    (Action::HorizontalScrollLeft, 0x01),
+    (Action::HorizontalScrollRight, 0x02),
+];
+
+fn modifiers_to_hid(combo: &KeyCombo) -> u8 {
+    let mut bits = 0;
+    if combo.has_command() {
+        bits |= PRIMARY;
+    }
+    if combo.has_control() {
+        bits |= CTRL;
+    }
+    if combo.has_shift() {
+        bits |= SHIFT;
+    }
+    if combo.has_option() {
+        bits |= ALT;
+    }
+    if combo.has_super() {
+        bits |= GUI;
+    }
+    bits
+}
+
+fn modifiers_from_hid(bits: u8) -> Modifiers {
+    // Fold the right-hand modifiers onto the left ones.
+    let bits = (bits | (bits >> 4)) & 0x0f;
+    let mut modifiers = Modifiers::empty();
+    if bits & CTRL != 0 {
+        modifiers |= Modifiers::CONTROL;
+    }
+    if bits & SHIFT != 0 {
+        modifiers |= Modifiers::SHIFT;
+    }
+    if bits & ALT != 0 {
+        modifiers |= Modifiers::OPTION;
+    }
+    if bits & GUI != 0 {
+        modifiers |= Modifiers::SUPER;
+    }
+    modifiers
+}
+
+fn key_action(modifiers: u8, usage: u8) -> Option<Action> {
+    let folded = (modifiers | (modifiers >> 4)) & 0x0f;
+    if let Some((action, ..)) = SHORTCUTS
+        .iter()
+        .find(|(_, m, u)| *m == folded && *u == usage)
+    {
+        return Some(action.clone());
+    }
+    let key = KeyboardUsage::try_from(usage).ok()?;
+    Some(Action::CustomShortcut(KeyCombo::new(
+        modifiers_from_hid(modifiers),
+        key,
+    )))
+}
+
+/// The chord a macro plays, when it is exactly one chord (G HUB stores a
+/// shortcut assigned to a button as such a macro).
+fn single_chord(steps: &[StoredMacroStep]) -> Option<(u8, u8)> {
+    let mut modifiers = 0;
+    let mut key = None;
+    let mut released = false;
+    for step in steps {
+        match *step {
+            StoredMacroStep::KeyDown(_, usage) => {
+                if released {
+                    return None; // a second chord
+                }
+                match usage {
+                    0xe0..=0xe7 => modifiers |= 1 << (usage - 0xe0),
+                    _ if key.is_none() => key = Some(usage),
+                    _ => return None,
+                }
+            }
+            StoredMacroStep::KeyUp(..) => released = true,
+            StoredMacroStep::Delay(_) => {}
+        }
+    }
+    Some((modifiers, key?))
+}
+
+/// What `binding` does, as an action; `None` when no action stands for it
+/// (profile switching, a multi-chord macro, a binding the codec keeps raw).
+#[must_use]
+pub fn action_for(binding: StoredBinding, profiles: &StoredProfiles) -> Option<Action> {
+    match binding {
+        StoredBinding::MouseButton(n) => {
+            MOUSE.iter().find(|(_, v)| *v == n).map(|(a, _)| a.clone())
+        }
+        StoredBinding::Key { modifiers, usage } => key_action(modifiers, usage),
+        StoredBinding::Consumer(code) => MEDIA
+            .iter()
+            .find(|(_, v)| *v == code)
+            .map(|(a, _)| a.clone()),
+        StoredBinding::Special { function, .. } => FUNCTIONS
+            .iter()
+            .find(|(_, v)| *v == function)
+            .map(|(a, _)| a.clone()),
+        StoredBinding::StoredMacro { sector, offset } => {
+            let steps = profiles.stored_macro(sector, offset)?.steps.as_ref().ok()?;
+            let (modifiers, usage) = single_chord(steps)?;
+            key_action(modifiers, usage)
+        }
+        StoredBinding::Disabled => Some(Action::None),
+        StoredBinding::Other(_) => None,
+    }
+}
+
+/// How the mouse stores `action`; `None` when a profile can't hold it.
+#[must_use]
+pub fn binding_for(action: &Action) -> Option<StoredBinding> {
+    if let Some((_, n)) = MOUSE.iter().find(|(a, _)| a == action) {
+        return Some(StoredBinding::MouseButton(*n));
+    }
+    if let Some((_, code)) = MEDIA.iter().find(|(a, _)| a == action) {
+        return Some(StoredBinding::Consumer(*code));
+    }
+    if let Some((_, function)) = FUNCTIONS.iter().find(|(a, _)| a == action) {
+        return Some(StoredBinding::Special {
+            function: *function,
+            profile: 0,
+        });
+    }
+    if let Some((_, modifiers, usage)) = SHORTCUTS.iter().find(|(a, ..)| a == action) {
+        return Some(StoredBinding::Key {
+            modifiers: *modifiers,
+            usage: *usage,
+        });
+    }
+    match action {
+        Action::None => Some(StoredBinding::Disabled),
+        Action::CustomShortcut(combo) => Some(StoredBinding::Key {
+            modifiers: modifiers_to_hid(combo),
+            usage: combo.key().into(),
+        }),
+        _ => None,
+    }
+}
+
+/// Every pickable action a stored profile can't hold, hidden from the picker
+/// while a stored profile is in control.
+pub static NOT_STORABLE: LazyLock<Vec<Action>> = LazyLock::new(|| {
+    Action::catalog()
+        .into_iter()
+        .filter(|action| binding_for(action).is_none())
+        .collect()
+});
+
+#[cfg(test)]
+mod stored_profiles_mapping {
+    use super::*;
+    use openlogi_core::hid::{OnboardMode, StoredMacro};
+
+    fn profiles_with(macros: Vec<StoredMacro>) -> StoredProfiles {
+        StoredProfiles {
+            mode: OnboardMode::Onboard,
+            active: None,
+            dpi_values: None,
+            profiles: Vec::new(),
+            factory_buttons: Vec::new(),
+            macros,
+        }
+    }
+
+    #[test]
+    fn storable_actions_round_trip() {
+        let none = profiles_with(Vec::new());
+        for action in Action::catalog() {
+            if let Some(binding) = binding_for(&action) {
+                assert_eq!(
+                    action_for(binding, &none),
+                    Some(action.clone()),
+                    "{action:?}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn g_hub_macros_that_are_one_chord_read_as_their_shortcut() {
+        let steps = |m: &[u8], key: u8| -> Vec<StoredMacroStep> {
+            let mut v: Vec<StoredMacroStep> =
+                m.iter().map(|&u| StoredMacroStep::KeyDown(0, u)).collect();
+            v.push(StoredMacroStep::Delay(50));
+            v.push(StoredMacroStep::KeyDown(0, key));
+            v.extend(m.iter().map(|&u| StoredMacroStep::KeyUp(0, u)));
+            v.push(StoredMacroStep::KeyUp(0, key));
+            v
+        };
+        // The four macros on a G903 HERO's side and DPI buttons.
+        let macros = vec![
+            StoredMacro {
+                sector: 6,
+                offset: 0x00,
+                steps: Ok(steps(&[0xe0], 0x2b)),
+            },
+            StoredMacro {
+                sector: 6,
+                offset: 0x16,
+                steps: Ok(steps(&[0xe0, 0xe1], 0x2b)),
+            },
+            StoredMacro {
+                sector: 6,
+                offset: 0x5a,
+                steps: Ok(steps(&[0xe0], 0x1a)),
+            },
+        ];
+        let profiles = profiles_with(macros);
+        let at = |offset| action_for(StoredBinding::StoredMacro { sector: 6, offset }, &profiles);
+        assert_eq!(at(0x00), Some(Action::NextTab));
+        assert_eq!(at(0x16), Some(Action::PrevTab));
+        if !cfg!(target_os = "macos") {
+            assert_eq!(at(0x5a), Some(Action::CloseTab));
+        }
+        assert_eq!(at(0x99), None, "a macro nobody points to");
+    }
+
+    #[test]
+    fn a_two_chord_macro_has_no_action() {
+        let steps = vec![
+            StoredMacroStep::KeyDown(0, 0x04),
+            StoredMacroStep::KeyUp(0, 0x04),
+            StoredMacroStep::KeyDown(0, 0x05),
+            StoredMacroStep::KeyUp(0, 0x05),
+        ];
+        let profiles = profiles_with(vec![StoredMacro {
+            sector: 6,
+            offset: 0,
+            steps: Ok(steps),
+        }]);
+        assert_eq!(
+            action_for(
+                StoredBinding::StoredMacro {
+                    sector: 6,
+                    offset: 0
+                },
+                &profiles
+            ),
+            None
+        );
+    }
+
+    #[test]
+    fn a_plain_key_reads_as_a_custom_shortcut_and_writes_back() {
+        let none = profiles_with(Vec::new());
+        let enter = StoredBinding::Key {
+            modifiers: 0,
+            usage: 0x28,
+        };
+        let action = action_for(enter, &none).expect("Enter is a key");
+        assert!(matches!(action, Action::CustomShortcut(_)));
+        assert_eq!(binding_for(&action), Some(enter));
+        let ctrl_alt_f5 = StoredBinding::Key {
+            modifiers: CTRL | ALT,
+            usage: 0x3e,
+        };
+        let action = action_for(ctrl_alt_f5, &none).expect("a chord");
+        assert_eq!(binding_for(&action), Some(ctrl_alt_f5));
+    }
+
+    #[test]
+    fn what_a_profile_cannot_hold_is_hidden() {
+        assert!(NOT_STORABLE.contains(&Action::ShowActionsRing));
+        assert!(NOT_STORABLE.contains(&Action::LockScreen));
+        assert!(!NOT_STORABLE.contains(&Action::MouseBack));
+        assert!(!NOT_STORABLE.contains(&Action::NextTab));
+        assert_eq!(binding_for(&Action::None), Some(StoredBinding::Disabled));
+    }
+}
