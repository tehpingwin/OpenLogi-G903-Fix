+async fn wire_settings_round_trip_and_cannot_resize_layers() {
+    let rig = Rig::new().await;
+    for slot in rig.read().await.profiles {
+        let decoded = slot.decoded.unwrap();
+        let wire = convert::settings_to_wire(&decoded);
+        assert_eq!(convert::settings_from_wire(&wire, &decoded), decoded);
+        let mut short = wire.clone();
+        short.buttons.truncate(3); // a caller sending too few buttons changes nothing else
+        short
+            .shift_buttons
+            .push(openlogi_core::hid::StoredBinding::Disabled); // or too many
+        assert_eq!(convert::settings_from_wire(&short, &decoded), decoded);
+    }
+}
